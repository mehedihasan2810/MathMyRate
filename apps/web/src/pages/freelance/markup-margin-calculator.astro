---
import { analyzePrice, priceFromMargin, priceFromMarkup } from "@MathMyRate/calculators";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EmbedSnippet from "../../components/EmbedSnippet.astro";
import MarkupMarginCalculator from "../../components/MarkupMarginCalculator.astro";
import DataTable from "../../components/DataTable.astro";
import FaqSection from "../../components/FaqSection.astro";
import PageByline from "../../components/PageByline.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import { findTool, toolBreadcrumbs } from "../../data/tools";
import Layout from "../../layouts/Layout.astro";
import type { FaqEntry } from "../../lib/structured-data";
import { formatPercentBps, formatUsdGrouped } from "../../scripts/calculator-form";

const tool = findTool("markup-margin");

const breadcrumbs = toolBreadcrumbs(tool.id);

const example = priceFromMarkup({ costCents: 4_000n, markupBps: 5_000 });

const marginExample = priceFromMargin({ costCents: 4_000n, marginBps: 5_000 });

const mistake = analyzePrice({ costCents: 10_000n, priceCents: 13_000n });

const thirtyMargin = priceFromMargin({ costCents: 10_000n, marginBps: 3_000 });

function percent(bps: bigint | null): string {
  return bps === null ? "Not defined" : formatPercentBps(bps);
}

function wholePercent(bps: number): string {
  return `${bps / 100}%`;
}

const markupRows = [1_000, 2_000, 2_500, 3_000, 5_000, 7_500, 10_000, 15_000, 20_000].map((markupBps) => {
  const result = priceFromMarkup({ costCents: 10_000n, markupBps });

  return [wholePercent(markupBps), formatUsdGrouped(result.priceCents), formatUsdGrouped(result.profitCents), percent(result.marginBps)];
});

const marginRows = [1_000, 2_000, 2_500, 3_000, 4_000, 5_000, 6_000, 7_500].map((marginBps) => {
  const result = priceFromMargin({ costCents: 10_000n, marginBps });

  return [wholePercent(marginBps), formatUsdGrouped(result.priceCents), formatUsdGrouped(result.profitCents), percent(result.markupBps)];
});

const updatedOn = "2026-09-15";

const faq: readonly FaqEntry[] = [
  { question: "What is the difference between markup and margin?", answer: `Both describe the same profit. Markup compares it with the cost; margin compares it with the selling price. A $40 cost sold for $60 has a $20 profit, which is a 50% markup but a ${percent(example.marginBps)} margin.` },
  { question: "How do I convert markup to margin?", answer: "Divide the markup by one plus the markup. A 50% markup is 0.5 ÷ 1.5, a 33.33% margin. To go the other way, divide the margin by one minus the margin: a 25% margin is 0.25 ÷ 0.75, a 33.33% markup." },
  { question: "What markup gives a 50% margin?", answer: `A 100% markup. Doubling a $40 cost to ${formatUsdGrouped(marginExample.priceCents)} leaves a $40 profit, which is half of the price.` },
  { question: "Can margin be more than 100%?", answer: "No. Margin is profit as a share of the price, and profit can never be larger than the price. A margin close to 100% means the cost is close to zero, so the calculator accepts margins up to 99.99%. Markup has no such limit: a 300% markup is common for low-cost goods." },
  { question: "Why is the price rounded up?", answer: "Prices are in whole cents. Rounding up means the markup or margin you get is never below the one you asked for; rounding down could leave you a fraction short." },
  { question: "What if my price is below cost?", answer: "Choose Check a price. The profit, markup, and margin all show as negative numbers, so you can see how much each sale loses." },
  { question: "Does this include sales tax or payment fees?", answer: "No. Enter the cost of the item or work, and price before tax. To see what a payment processor keeps from that price, use one of the fee calculators." },
  { question: "Is my information saved or sent anywhere?", answer: "No. Everything is calculated in your browser, and nothing is stored." },
];
---
<Layout title="Markup and Margin Calculator: Price and Profit | MathMyRate" description="Set a price from a markup or a target margin, or check the markup and margin of a price you charge. See the profit and both percentages at once." ogImage="/og/markup-margin.png" breadcrumbs={breadcrumbs} applicationName={tool.name}>
  <main id="main-content" class="mx-auto max-w-6xl px-5 py-8 md:px-8 md:py-10">
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="display mt-3 text-3xl font-bold md:text-4xl">{tool.name}</h1>
    <p class="mt-2 max-w-2xl leading-relaxed text-ink/70">Price from a markup or a margin, or check the numbers on a price you already charge. See the profit, the markup, and the margin side by side.</p>
    <PageByline updatedOn={updatedOn} />
    <MarkupMarginCalculator />
    <article class="guide mt-14 border-t border-line pt-4">
      <h2>What this calculator tells you</h2>
      <p>The markup and margin calculator turns a cost into a selling price, or shows what a price earns. Markup is profit as a share of the <em>cost</em>; margin is profit as a share of the <em>price</em>. A $40.00 cost with a 50% markup sells for <strong>{formatUsdGrouped(example.priceCents)}</strong>, which is a margin of only <strong>{percent(example.marginBps)}</strong>. For a 50% margin, you would charge <strong>{formatUsdGrouped(marginExample.priceCents)}</strong>.</p>

      <h2>How to use it</h2>
      <ol>
        <li>Choose what you want: a price from a markup, a price from a margin, or the markup and margin of a price.</li>
        <li>Enter your cost: what you paid for the item, or what the work costs you, such as a subcontractor's invoice.</li>
        <li>Enter the markup or margin you want, or the price you charge. The result updates as you type.</li>
      </ol>

      <h2>The formulas</h2>
      <ul>
        <li><strong>Profit</strong> = price − cost</li>
        <li><strong>Markup</strong> = profit ÷ cost</li>
        <li><strong>Margin</strong> = profit ÷ price</li>
        <li><strong>Price from a markup</strong> = cost × (1 + markup)</li>
        <li><strong>Price from a margin</strong> = cost ÷ (1 − margin)</li>
        <li><strong>Markup to margin</strong> = markup ÷ (1 + markup), and <strong>margin to markup</strong> = margin ÷ (1 − margin)</li>
      </ul>

      <h2>Markup to margin</h2>
      <p>Each row starts from a $100.00 cost.</p>
      <DataTable caption="Selling price and margin for each markup on a $100 cost" headers={["Markup", "Price", "Profit", "Margin"]} rows={markupRows} />

      <h2>Margin to markup</h2>
      <p>Each row starts from a $100.00 cost. Prices are rounded up to the cent, so each margin is at least the one named.</p>
      <DataTable caption="Selling price and markup for each margin on a $100 cost" headers={["Margin", "Price", "Profit", "Markup"]} rows={marginRows} />

      <h2>The mistake this prevents</h2>
      <p>Adding 30% to a $100 cost gives a $130 price. That is a 30% markup, but its margin is <strong>{percent(mistake.marginBps)}</strong>. If you planned on keeping 30% of every sale, you would fall short. A true 30% margin on a $100 cost needs a price of <strong>{formatUsdGrouped(thirtyMargin.priceCents)}</strong>.</p>

      <h2>Which one should you use?</h2>
      <p>Markup is convenient when you start from a cost and add to it. Margin is useful when you think in shares of revenue, because rent, software, and payment fees are also paid out of the price the customer pays. The calculator shows both, so you can quote from one and check against the other. Read <a href="/guides/markup-vs-margin/">markup vs margin</a> for more examples.</p>

      <FaqSection entries={faq} />

      <EmbedSnippet toolId={tool.id} />

      <p class="text-sm text-ink/60">Planning estimate only; not tax, accounting, or legal advice. See <a href="/methodology/">how the numbers are made</a>.</p>
    </article>
    <RelatedTools current={tool.id} />
  </main>
</Layout>
