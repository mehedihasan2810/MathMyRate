---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { hubBreadcrumbs } from "../../data/tools";
import Layout from "../../layouts/Layout.astro";

const breadcrumbs = hubBreadcrumbs("freelance");
---
<Layout title="Freelance Rate Calculators: Hourly and Project | MathMyRate" description="Free freelance pricing calculators: find a sustainable hourly and day rate, then carry it into a scoped project quote with contingency and expenses." breadcrumbs={breadcrumbs}>
  <main id="main-content" class="mx-auto max-w-6xl px-5 py-10 md:px-8 md:py-16">
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="display mt-4 max-w-3xl text-4xl font-bold leading-tight md:text-5xl">Freelance Rate Calculators</h1>
    <p class="mt-4 max-w-2xl text-xl font-semibold text-ink">Start with the work. Then price it properly.</p>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink/70">Use the annual tool to establish a sustainable floor. Carry that rate into a scoped project quote when you are ready.</p>
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      <a href="/freelance/hourly-rate-calculator/" class="rounded-[1.5rem] border border-line bg-[#fafbfd] p-8 transition-transform hover:-translate-y-1"><p class="eyebrow">01 / Capacity</p><h2 class="display mt-5 text-3xl font-bold">Freelance Hourly Rate Calculator</h2><p class="mt-4 text-ink/65">Calculate the annual revenue, hourly floor, and day rate required for your working year.</p><span class="mt-8 block font-semibold text-navy">Calculate my rate →</span></a>
      <a href="/freelance/project-rate-calculator/" class="rounded-[1.5rem] border border-line bg-[#fafbfd] p-8 transition-transform hover:-translate-y-1"><p class="eyebrow">02 / Scope</p><h2 class="display mt-5 text-3xl font-bold">Freelance Project Rate Calculator</h2><p class="mt-4 text-ink/65">Calculate labor, contingency, reimbursable expenses, and a clear receipt target.</p><span class="mt-8 block font-semibold text-gold">Build a quote →</span></a>
    </div>
  </main>
</Layout>