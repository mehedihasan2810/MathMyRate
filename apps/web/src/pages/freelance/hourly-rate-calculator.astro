---
import { calculateFreelanceRate } from "@MathMyRate/calculators";
import Layout from "../../layouts/Layout.astro";
import { formatUsdGrouped } from "../../scripts/calculator-form";

const defaults = { takeHome: "85000.00", expenses: "7500.00", tax: "27.00", weeks: "46", hoursWeek: "40", billable: "65.00", hoursDay: "7" };
const example = calculateFreelanceRate({ annualTakeHomeCents: 8500000n, annualExpensesCents: 750000n, taxRateBps: 2700, weeksPerYear: 46, hoursPerWeek: 40, billablePercentBps: 6500, hoursPerDay: 7 });
const fields = [
  ["takeHome", "Desired annual take-home", defaults.takeHome, "Enter the money you want to keep after your planning tax reserve."],
  ["expenses", "Annual business expenses", defaults.expenses, "Software, insurance, subcontractors, and other annual costs."],
  ["tax", "Effective tax reserve (%)", defaults.tax, "A planning assumption, not a tax calculation."],
  ["weeks", "Working weeks / year", defaults.weeks, "Whole weeks available for client work."],
  ["hoursWeek", "Working hours / week", defaults.hoursWeek, "Whole working hours each week."],
  ["billable", "Billable time (%)", defaults.billable, "The proportion of working time you expect to invoice."],
  ["hoursDay", "Hours in your day", defaults.hoursDay, "Whole hours used to show a day rate."],
] as const;
---
<Layout title="Freelance Hourly Rate Calculator | MathMyRate">
  <main id="main-content" class="mx-auto max-w-6xl px-5 py-12 md:px-8 md:py-16">
    <p class="eyebrow">Freelance pricing / 01</p>
    <h1 class="display mt-4 max-w-3xl text-5xl font-bold leading-none md:text-6xl">Build a rate with room to work.</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink/70">A clear annual-capacity estimate with exact cents, named assumptions, and no hidden tax logic.</p>
    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_.85fr]">
      <form id="hourly-form" class="print-card rounded-[1.5rem] border border-line bg-[#faf8f1] p-6 shadow-[0_16px_45px_rgba(56,71,61,.08)] md:p-8" novalidate>
        <div class="flex items-baseline justify-between"><h2 class="display text-2xl font-bold">Example working year</h2><span class="mono text-xs text-ink/50">USD / annual</span></div>
        <p class="mt-2 text-sm text-ink/60">Example defaults: $85,000 take-home, 46 weeks, and 65% billable time.</p>
        <div data-error-summary role="alert" hidden class="mt-5 rounded-lg border border-[#d99c89] bg-[#fff0e9] p-3 text-sm text-[#8f3c2d]"></div>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          {fields.map(([id, label, value, help]) => <label class="text-sm font-semibold">{label}<input id={id} data-field={id} aria-describedby={`${id}-help ${id}-error`} inputmode={["weeks","hoursWeek","hoursDay"].includes(id) ? "numeric" : "decimal"} value={value} class="mt-2 w-full rounded-lg border border-line bg-paper px-3 py-3 text-base font-medium" /><span id={`${id}-help`} class="mt-1 block text-xs font-normal text-ink/55">{help}</span><span id={`${id}-error`} class="field-error" role="alert"></span></label>)}
        </div>
        <div class="calculator-actions mt-7 flex flex-wrap gap-3"><button class="rounded-full bg-ink px-5 py-2.5 text-sm font-bold text-paper" type="submit">Update rate</button><button id="hourly-reset" class="rounded-full border border-line px-5 py-2.5 text-sm font-semibold" type="button">Reset example</button></div>
      </form>
      <aside aria-live="polite" class="print-card h-fit rounded-[1.5rem] bg-moss p-7 text-paper shadow-[0_16px_45px_rgba(56,71,61,.16)] md:p-9">
        <p class="eyebrow !text-[#c6d9c6]">Minimum sustainable rate</p><p id="hourly-result" class="result-value display mt-4 text-6xl font-bold">{formatUsdGrouped(example.hourlyRateCents)}</p><p class="mt-1 text-paper/70">per hour before project-specific payment fees</p>
        <div class="my-7 border-t border-paper/25"></div><div class="flex justify-between"><span class="text-paper/70">Day rate</span><strong id="day-result" class="text-xl">{formatUsdGrouped(example.dayRateCents)}</strong></div><div class="mt-4 flex justify-between"><span class="text-paper/70">Annual revenue needed</span><strong id="revenue-result">{formatUsdGrouped(example.annualRevenueCents)}</strong></div><div class="mt-4 flex justify-between"><span class="text-paper/70">Billable capacity</span><strong id="capacity-result">{example.annualBillableHours.toLocaleString()} hours</strong></div>
        <div class="calculator-actions mt-8 flex flex-wrap gap-2"><button id="transfer-rate" type="button" class="rounded-full bg-paper px-4 py-2.5 text-sm font-bold text-ink">Use in project quote</button><button id="copy-hourly" type="button" class="rounded-full border border-paper/35 px-4 py-2.5 text-sm font-bold">Copy result</button><button type="button" onclick="window.print()" class="rounded-full border border-paper/35 px-4 py-2.5 text-sm font-bold">Print</button></div><p id="hourly-message" class="mt-4 text-sm text-[#d6e6d5]"></p>
      </aside>
    </div>
    <noscript><p class="mt-5 rounded-lg border border-line bg-mist p-4 text-sm">The worked example is shown above. Enable JavaScript to update calculations locally.</p></noscript>
    <section class="mt-14 max-w-3xl border-t border-line pt-10"><h2 class="display text-3xl font-bold">How this number is built</h2><p class="mt-4 leading-relaxed text-ink/70">Annual revenue is your desired take-home grossed up once for the effective tax reserve, plus annual business expenses. That revenue is divided by billable capacity and rounded up to the nearest cent.</p><p class="mt-4 text-sm text-ink/60">Planning estimate only; not tax, accounting, or legal advice. No payment fees or currency conversion are included.</p></section>
  </main>
  <script>
    import { calculateFreelanceRate } from "@MathMyRate/calculators";
    import { formatUsdGrouped, InputProblem, percentToBps, setFieldState, usdToCents, wholeNumber } from "../../scripts/calculator-form";
    const form = document.querySelector<HTMLFormElement>("#hourly-form")!;
    const input = (id: string) => document.getElementById(id) as HTMLInputElement;
    const action = (id: string) => document.getElementById(id) as HTMLButtonElement;
    const message = document.getElementById("hourly-message")!;
    let latest: bigint | null = null;
    function clear() { ["hourly-result","day-result","revenue-result","capacity-result"].forEach(id => document.getElementById(id)!.textContent = "—"); latest = null; action("copy-hourly").disabled = true; action("transfer-rate").disabled = true; }
    function update() { try {
      const result = calculateFreelanceRate({ annualTakeHomeCents: usdToCents(input("takeHome").value, "takeHome"), annualExpensesCents: usdToCents(input("expenses").value, "expenses"), taxRateBps: percentToBps(input("tax").value, "tax", 9999), weeksPerYear: wholeNumber(input("weeks").value, "weeks", 1, 52), hoursPerWeek: wholeNumber(input("hoursWeek").value, "hoursWeek", 1, 168), billablePercentBps: percentToBps(input("billable").value, "billable", 10000), hoursPerDay: wholeNumber(input("hoursDay").value, "hoursDay", 1, 24) });
      document.getElementById("hourly-result")!.textContent = formatUsdGrouped(result.hourlyRateCents); document.getElementById("day-result")!.textContent = formatUsdGrouped(result.dayRateCents); document.getElementById("revenue-result")!.textContent = formatUsdGrouped(result.annualRevenueCents); document.getElementById("capacity-result")!.textContent = `${result.annualBillableHours.toLocaleString()} hours`; latest = result.hourlyRateCents; action("copy-hourly").disabled = false; action("transfer-rate").disabled = false; message.textContent = ""; setFieldState(form);
    } catch (e) { clear(); const p = e instanceof InputProblem ? e : new InputProblem("billable", "Working capacity must be greater than zero."); setFieldState(form, p); } }
    form.addEventListener("submit", e => { e.preventDefault(); update(); }); form.querySelectorAll("input").forEach(el => el.addEventListener("input", update));
    action("hourly-reset").addEventListener("click", () => { form.reset(); try { localStorage.removeItem("mathmyrate:hourly-cents"); } catch {} update(); });
    action("transfer-rate").addEventListener("click", () => { if (latest === null) return; try { localStorage.setItem("mathmyrate:hourly-cents", latest.toString()); location.href = "/freelance/project-rate-calculator/"; } catch { message.textContent = "Your browser could not save this rate. Copy it into the project calculator instead."; } });
    action("copy-hourly").addEventListener("click", async () => { if (latest === null) return; try { await navigator.clipboard.writeText(`Minimum hourly rate: ${formatUsdGrouped(latest)}`); message.textContent = "Result copied."; } catch { message.textContent = "Copy was unavailable. Select the result to copy it manually."; } });
    update();
  </script>
</Layout>