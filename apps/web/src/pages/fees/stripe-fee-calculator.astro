---
import { calculateFees, grossUpFees } from "@MathMyRate/calculators";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DataTable from "../../components/DataTable.astro";
import FaqSection from "../../components/FaqSection.astro";
import FeeCalculator from "../../components/FeeCalculator.astro";
import FeeRuleDetails from "../../components/FeeRuleDetails.astro";
import PageByline from "../../components/PageByline.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import { findFeeCalculator } from "../../data/fee-calculators";
import { findTool, toolBreadcrumbs } from "../../data/tools";
import Layout from "../../layouts/Layout.astro";
import { formatCombinedRate } from "../../lib/fee-labels";
import { commonSaleAmounts, feeRowsByAmount, requireOfficialPreset, scenarioRowsAt } from "../../lib/fee-tables";
import type { FaqEntry } from "../../lib/structured-data";
import { formatUsdGrouped } from "../../scripts/calculator-form";

const tool = findTool("stripe-fees");

const breadcrumbs = toolBreadcrumbs(tool.id);

const config = findFeeCalculator("stripe");

const domestic = requireOfficialPreset("stripe-us-online-domestic-card");

const international = requireOfficialPreset("stripe-us-online-international-card");

const rate = formatCombinedRate(domestic.components);

const sale = calculateFees({ preset: domestic, grossCents: 10000n });

const internationalSale = calculateFees({ preset: international, grossCents: 10000n });

const internationalAddOn = internationalSale.lineItems[1]?.feeCents ?? 0n;

const target = grossUpFees({ preset: domestic, targetProceedsCents: 10000n });

const smallSale = calculateFees({ preset: domestic, grossCents: 1000n });

const fee = formatUsdGrouped(sale.feeCents);

const kept = formatUsdGrouped(sale.sellerProceedsCents);

const amountRows = feeRowsByAmount(domestic, commonSaleAmounts);

const scenarioRows = scenarioRowsAt(config.scenarios, 10000n);

const updatedOn = "2026-09-15";

const title = `${tool.name} (${rate}) | MathMyRate`;

const description = `Estimate Stripe's ${rate} US card fee plus international and manual card fees, what you keep from a sale, and what to charge to net a target.`;

const guideSources = [
  { title: "Pricing & Fees | Stripe", url: "https://stripe.com/pricing" },
  { title: "Refund and cancel payments | Stripe Documentation", url: "https://docs.stripe.com/refunds" },
  { title: "How disputes work | Stripe Documentation", url: "https://docs.stripe.com/disputes/how-disputes-work" },
  { title: "Payouts | Stripe Documentation", url: "https://docs.stripe.com/payouts" },
  { title: "Stripe Billing pricing", url: "https://stripe.com/billing/pricing" },
  { title: "Stripe Tax pricing", url: "https://stripe.com/tax/pricing" },
];

const faq: readonly FaqEntry[] = [
  { question: "How much does Stripe charge per transaction?", answer: `On standard pricing for a US account, Stripe charges ${rate} per successful online payment with a domestic card. Its pricing page adds 1.5% for international cards, 0.5% for manually entered cards, and 1% when currency conversion is required.` },
  { question: "Is the 30¢ charged on every payment?", answer: `Yes. The 30¢ is part of the price of each successful transaction, so small payments lose a larger share. A $10 payment pays ${formatUsdGrouped(smallSale.feeCents)}, which is more than 5% of the sale, while a $100 payment pays ${fee}.` },
  { question: "Does Stripe return its fee when I refund a customer?", answer: "No. On standard pricing, Stripe charges no fee to issue a refund for card payments, but the processing fees from the original payment are not returned." },
  { question: "How much is a Stripe dispute fee?", answer: "Stripe charges $15.00 for each dispute you receive, and that fee is not returned. If you respond to the dispute manually, a second $15.00 countered fee applies, which Stripe gives back if you win." },
  { question: "Does Stripe have setup or monthly fees?", answer: "Not on standard pricing. Stripe's pricing page says there are no setup fees, monthly fees, or hidden fees such as closure fees. Optional products such as Billing and Tax have their own prices." },
  { question: "How do I charge enough to cover Stripe's fee?", answer: `Choose I want to keep a target and enter the amount you want to receive. The calculator finds the smallest charge that still leaves that amount after the fee. To keep $100.00 from a domestic card payment, charge ${formatUsdGrouped(target.grossCents)}.` },
  { question: "What does Stripe charge for international cards?", answer: `Stripe's pricing page adds 1.5% for international cards, which this calculator adds to the domestic ${rate}. A $100 payment with an international card pays ${formatUsdGrouped(internationalSale.feeCents)}. If the payment also needs currency conversion, Stripe adds another 1%, which is not included here.` },
  { question: "Does Stripe charge to pay out to my bank?", answer: "Standard payouts are free. Instant Payouts for US accounts cost 1.5% of the payout amount, with a 50¢ minimum fee." },
  { question: "Does Stripe collect sales tax for me?", answer: "Not by default. Stripe Tax is a separate paid product. Its Tax Basic plan costs 0.5% per transaction for no-code integrations, or 50¢ per transaction through the API, where you are registered to collect tax." },
];
---
<Layout title={title} description={description} ogImage="/og/stripe.png" breadcrumbs={breadcrumbs} applicationName={tool.name}>
  <main id="main-content" class="mx-auto max-w-6xl px-5 py-8 md:px-8 md:py-10">
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="display mt-3 text-3xl font-bold md:text-4xl">{tool.name}</h1>
    <p class="mt-2 max-w-2xl leading-relaxed text-ink/70">Know the fee before you quote. Standard US online card payments at {rate}, plus international and manually entered cards, worked out in cents.</p>
    <PageByline updatedOn={updatedOn} reviewedOn={domestic.checkedOn} />
    <FeeCalculator calculatorId="stripe" />
    <article class="guide mt-14 border-t border-line pt-4">
      <h2>What this calculator tells you</h2>
      <p>The Stripe fee calculator shows what Stripe keeps from a card payment and what reaches you. For a US account on standard pricing, Stripe charges <strong>{rate}</strong> per successful online payment with a domestic card, so a $100 sale pays <strong>{fee}</strong> and leaves <strong>{kept}</strong>. It also covers international cards and manually entered cards, and it can work backward from the amount you want to keep.</p>

      <h2>How to use it</h2>
      <ol>
        <li>Choose the kind of card payment: domestic, international, or manually entered.</li>
        <li>Choose whether you know what the customer paid, or what you want to keep.</li>
        <li>Enter the amount. If you collected sales tax on the payment, enter it so it is not counted as yours.</li>
        <li>To see monthly and yearly totals, enter how many same-size sales you make a month.</li>
      </ol>

      <h2>How the fee is built</h2>
      <p>Here is a $100.00 payment, using the same code as the calculator.</p>
      <ol>
        <li><strong>Percentage.</strong> 2.9% of $100.00 is $2.90.</li>
        <li><strong>Fixed charge.</strong> Adding 30¢ gives a fee of {fee}, so you keep {kept}.</li>
        <li><strong>International card.</strong> A card issued outside the US adds 1.5%, another {formatUsdGrouped(internationalAddOn)}, for a total of {formatUsdGrouped(internationalSale.feeCents)}.</li>
        <li><strong>Working backward.</strong> To keep $100.00 from a domestic card payment, charge {formatUsdGrouped(target.grossCents)}. Its fee is {formatUsdGrouped(target.feeCents)}.</li>
      </ol>

      <h2>Stripe fees at common sale amounts</h2>
      <p>Domestic online card payments on standard pricing. The fixed 30¢ is why the share of a small sale is higher.</p>
      <DataTable caption={`Stripe domestic card fee (${rate}) by sale amount`} headers={["Sale", "Stripe fee", "You keep", "Fee share"]} rows={amountRows} />

      <h2>The same $100 sale in every scenario</h2>
      <DataTable caption="Stripe fee on a $100 payment by card scenario" headers={["Scenario", "Rate", "Stripe fee", "You keep"]} rows={scenarioRows} />

      <h2>Other Stripe fees this calculator does not add</h2>
      <p>These come from Stripe's pricing page and documentation for US accounts on standard pricing. They apply in their own situations, so they are not part of a normal card payment above.</p>
      <ul>
        <li><strong>Currency conversion:</strong> an extra 1% when a payment needs converting.</li>
        <li><strong>ACH Direct Debit:</strong> 0.8% per successful charge, capped at $5.00.</li>
        <li><strong>Disputes:</strong> $15.00 for each dispute received, not returned, plus $15.00 if you respond manually, returned if you win.</li>
        <li><strong>Refunds:</strong> no fee to refund a card payment, but the original processing fees are not returned.</li>
        <li><strong>Instant Payouts:</strong> 1.5% of the payout, with a 50¢ minimum fee. Standard payouts are free.</li>
        <li><strong>Stripe Billing:</strong> 0.7% of Billing volume on pay-as-you-go pricing, for subscriptions and recurring charges.</li>
        <li><strong>Stripe Tax:</strong> Tax Basic is 0.5% per transaction for no-code integrations or 50¢ through the API, where you are registered to collect tax.</li>
      </ul>

      <FeeRuleDetails calculatorId="stripe" />

      <FaqSection entries={faq} />

      <h2>Sources</h2>
      <ul class="text-base">{guideSources.map((source) => <li><a href={source.url} rel="noopener">{source.title}</a></li>)}</ul>
      <p class="text-sm text-ink/60">Stripe's pages were reviewed on the date shown at the top of this page. Custom or negotiated pricing can differ. MathMyRate is not affiliated with Stripe. See <a href="/methodology/">how the numbers are made</a> and the <a href="/changelog/">changelog</a>.</p>
    </article>
    <RelatedTools current={tool.id} />
  </main>
</Layout>
