---
import { calculateFees } from "@MathMyRate/calculators";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DataTable from "../../components/DataTable.astro";
import FaqSection from "../../components/FaqSection.astro";
import FeeCalculator from "../../components/FeeCalculator.astro";
import FeeRuleDetails from "../../components/FeeRuleDetails.astro";
import PageByline from "../../components/PageByline.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import { findFeeCalculator } from "../../data/fee-calculators";
import { findTool, toolBreadcrumbs } from "../../data/tools";
import Layout from "../../layouts/Layout.astro";
import { formatCombinedRate } from "../../lib/fee-labels";
import { commonSaleAmounts, feeColumnsByAmount, requireOfficialPreset, scenarioRowsAt } from "../../lib/fee-tables";
import type { FaqEntry } from "../../lib/structured-data";
import { formatUsdGrouped } from "../../scripts/calculator-form";

const tool = findTool("gumroad-fees");

const breadcrumbs = toolBreadcrumbs(tool.id);

const config = findFeeCalculator("gumroad");

const direct = requireOfficialPreset("gumroad-us-direct-card");

const highVolume = requireOfficialPreset("gumroad-us-direct-card-high-volume");

const discover = requireOfficialPreset("gumroad-us-discover");

const directSale = calculateFees({ preset: direct, grossCents: 10000n });

const highVolumeSale = calculateFees({ preset: highVolume, grossCents: 10000n });

const discoverSale = calculateFees({ preset: discover, grossCents: 10000n });

const directRate = formatCombinedRate(direct.components);

const amountRows = feeColumnsByAmount(["gumroad-us-direct-card", "gumroad-us-direct-card-high-volume", "gumroad-us-discover"], commonSaleAmounts);

const scenarioRows = scenarioRowsAt(config.scenarios, 10000n);

const updatedOn = "2026-09-15";

const description = "Estimate Gumroad fees on direct sales (10% + 50¢ plus 2.9% + 30¢ card processing) and Discover sales (30%), what you keep, and what to charge.";

const guideSources = [
  { title: "Gumroad pricing", url: "https://gumroad.com/pricing" },
  { title: "Gumroad's fees - Gumroad Help Center", url: "https://gumroad.com/help/article/66-gumroads-fees.html" },
  { title: "Sales tax on Gumroad - Gumroad Help Center", url: "https://gumroad.com/help/article/121-sales-tax-on-gumroad.html" },
  { title: "How to refund a customer - Gumroad Help Center", url: "https://gumroad.com/help/article/47-how-to-refund-a-customer.html" },
  { title: "Getting paid - Gumroad Help Center", url: "https://gumroad.com/help/article/13-getting-paid.html" },
  { title: "How does Gumroad handle chargebacks - Gumroad Help Center", url: "https://gumroad.com/help/article/134-how-does-gumroad-handle-chargebacks.html" },
];

const faq: readonly FaqEntry[] = [
  { question: "How much does Gumroad take from a sale?", answer: `For a direct card sale, Gumroad charges 10% + $0.50 and card processing adds 2.9% + $0.30, so a $100 sale pays ${formatUsdGrouped(directSale.feeCents)}. A sale through Gumroad's Discover marketplace pays a flat 30%, or ${formatUsdGrouped(discoverSale.feeCents)} on $100, which includes processing.` },
  { question: "Is Gumroad's 10% fee the only fee on a direct sale?", answer: "No. Gumroad's fee list says the 10% + $0.50 does not include credit card processing of 2.9% + $0.30, so this calculator adds both. Gumroad's refund help describes processing as a portion of its fee, which conflicts with that list, so treat the result as an estimate and check your sales export." },
  { question: "What does Gumroad charge for Discover sales?", answer: "When a new customer finds and buys your product through Gumroad Discover, Gumroad charges a flat 30% per transaction, and that fee includes all processing fees." },
  { question: "How does the $20,000 monthly threshold work?", answer: `Once your paid sales in a calendar month reach $20,000, new direct sales that month cost 5% + $0.50 instead of 10% + $0.50. It applies automatically, resets on the 1st, and a refund can take you back under the threshold. Discover sales stay at 30%. A $100 direct sale after the threshold pays ${formatUsdGrouped(highVolumeSale.feeCents)} including card processing.` },
  { question: "Does Gumroad add sales tax on top of my price?", answer: "Yes. Gumroad has been the merchant of record for all sales since January 1, 2025, and collects and remits sales tax, VAT, and GST. Its terms say prices are exclusive of indirect tax, so tax is added at checkout. This calculator covers orders with no tax collected." },
  { question: "Does Gumroad return its fee when I refund a customer?", answer: "For a normal Gumroad sale, Gumroad returns its own fee on the refunded portion and keeps only the payment-processing portion. Sales through a connected Stripe or PayPal account are handled differently." },
  { question: "When does Gumroad pay out, and what does it cost?", answer: "You need a balance of at least $100 for a payout. Creators are typically paid weekly, after a 7-day holding period, and can choose daily, monthly, or quarterly payouts instead. PayPal payouts have a 2% processing fee, and US instant payouts cost 3%." },
  { question: "What does Gumroad charge on PayPal sales?", answer: "Gumroad lists PayPal fees separately from its own fee but does not publish the PayPal rate on its fee page, so this calculator does not estimate PayPal sales." },
];
---
<Layout title="Gumroad Fee Calculator: Direct & Discover | MathMyRate" description={description} ogImage="/og/gumroad.png" breadcrumbs={breadcrumbs} applicationName={tool.name}>
  <main id="main-content" class="mx-auto max-w-6xl px-5 py-8 md:px-8 md:py-10">
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="display mt-3 text-3xl font-bold md:text-4xl">{tool.name}</h1>
    <p class="mt-2 max-w-2xl leading-relaxed text-ink/70">Gumroad's cut, worked out in cents, for direct sales, the $20,000 monthly threshold, and Discover marketplace sales.</p>
    <PageByline updatedOn={updatedOn} reviewedOn={direct.checkedOn} />
    <FeeCalculator calculatorId="gumroad" />
    <article class="guide mt-14 border-t border-line pt-4">
      <h2>What this calculator tells you</h2>
      <p>The Gumroad fee calculator shows what Gumroad keeps from a digital product sale and what reaches you. A direct card sale pays Gumroad's 10% + $0.50 plus 2.9% + $0.30 card processing, a combined <strong>{directRate}</strong>, so a $100 sale pays <strong>{formatUsdGrouped(directSale.feeCents)}</strong> and leaves <strong>{formatUsdGrouped(directSale.sellerProceedsCents)}</strong>. Discover marketplace sales pay a flat 30%, and direct sales get cheaper after $20,000 of paid sales in a month.</p>

      <h2>How to use it</h2>
      <ol>
        <li>Choose the kind of sale: a direct sale, a direct sale after the monthly threshold, or a Discover sale.</li>
        <li>Choose whether you know the price the customer paid, or what you want to keep.</li>
        <li>Enter the amount, before any sales tax Gumroad adds at checkout.</li>
        <li>To see monthly and yearly totals, enter how many same-size sales you make a month.</li>
      </ol>

      <h2>How the fee is built</h2>
      <p>Here is a $100.00 sale in each scenario, using the same code as the calculator.</p>
      <ol>
        <li><strong>Direct sale.</strong> Gumroad's 10% is $10.00, plus $0.50. Card processing is 2.9%, or $2.90, plus $0.30. The total fee is {formatUsdGrouped(directSale.feeCents)}.</li>
        <li><strong>After the threshold.</strong> Gumroad's part drops to 5% + $0.50, or $5.50, while card processing stays $3.20, for {formatUsdGrouped(highVolumeSale.feeCents)}.</li>
        <li><strong>Discover sale.</strong> A flat 30% is {formatUsdGrouped(discoverSale.feeCents)}, with processing included.</li>
      </ol>

      <h2>Gumroad fees at common sale amounts</h2>
      <p>Card sales with no tax collected. The fixed charges make direct sales cost a larger share of a cheap product, while Discover takes the same 30% at every price.</p>
      <DataTable caption="Gumroad fee by sale amount and sale type" headers={["Sale", "Direct", "Direct after $20,000", "Discover"]} rows={amountRows} />

      <h2>The same $100 sale in every scenario</h2>
      <DataTable caption="Gumroad fee on a $100 sale by sale type" headers={["Scenario", "Rate", "Gumroad fee", "You keep"]} rows={scenarioRows} />

      <h2>The $20,000 monthly threshold</h2>
      <p>Once your paid sales in a calendar month reach $20,000, new direct sales that month cost 5% + $0.50 instead of 10% + $0.50. The lower fee applies automatically and resets on the 1st of each month, and a refund can bring you back under $20,000. Discover sales stay at 30%. Gumroad does not publish how it prices the single sale that crosses the threshold, so this calculator does not guess it.</p>

      <h2>Tax, refunds, payouts, and chargebacks</h2>
      <ul>
        <li><strong>Sales tax:</strong> Gumroad has been the merchant of record since January 1, 2025. It collects and remits sales tax, VAT, and GST, and adds tax on top of your price.</li>
        <li><strong>Refunds:</strong> Gumroad returns its own fee on the refunded portion of a sale and keeps the payment-processing portion.</li>
        <li><strong>Payouts:</strong> a $100 minimum balance, usually paid weekly after a 7-day holding period. PayPal payouts have a 2% fee, and US instant payouts cost 3%.</li>
        <li><strong>Chargebacks:</strong> Gumroad's chargeback help says you cover the refunded amount and payment-processing fees and Gumroad returns its platform fee. Other Gumroad pages describe chargeback costs differently, and no dispute fee amount is published.</li>
        <li><strong>Affiliates:</strong> fees on an affiliate sale are split between you and the affiliate in proportion to the affiliate's commission.</li>
      </ul>

      <FeeRuleDetails calculatorId="gumroad" blockedPresetIds={["gumroad-us-direct-threshold-crossing"]} />

      <FaqSection entries={faq} />

      <h2>Sources</h2>
      <ul class="text-base">{guideSources.map((source) => <li><a href={source.url} rel="noopener">{source.title}</a></li>)}</ul>
      <p class="text-sm text-ink/60">Gumroad's pages were reviewed on the date shown at the top of this page. Custom account fees can differ. MathMyRate is not affiliated with Gumroad. See <a href="/methodology/">how the numbers are made</a> and the <a href="/changelog/">changelog</a>.</p>
    </article>
    <RelatedTools current={tool.id} />
  </main>
</Layout>
