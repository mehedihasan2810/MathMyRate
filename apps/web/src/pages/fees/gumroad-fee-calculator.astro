---
import { calculateFees, getFeePreset } from "@MathMyRate/calculators";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import NumberField from "../../components/NumberField.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import ResultRow from "../../components/ResultRow.astro";
import StickyResult from "../../components/StickyResult.astro";
import { findTool, toolBreadcrumbs } from "../../data/tools";
import Layout from "../../layouts/Layout.astro";
import { formatFeeRate } from "../../lib/fee-labels";
import { formatUsdGrouped } from "../../scripts/calculator-form";

function requirePreset(id: string) {
  const preset = getFeePreset(id);

  if (!preset) {
    throw new Error(`The ${id} fee preset is missing from the registry.`);
  }

  return preset;
}

const directPreset = requirePreset("gumroad-us-direct-card");

const directHighVolumePreset = requirePreset("gumroad-us-direct-card-high-volume");

const discoverPreset = requirePreset("gumroad-us-discover");

const thresholdPreset = requirePreset("gumroad-us-direct-threshold-crossing");

const exampleSale = calculateFees({ preset: directPreset, grossCents: 10000n });

const scenarioDocs = [
  { heading: "Direct sale, before the threshold", preset: directPreset },
  { heading: "Direct sale, after the monthly threshold", preset: directHighVolumePreset },
  { heading: "Discover marketplace sale", preset: discoverPreset },
];

const sourceByUrl = new Map<string, { url: string; title: string }>();

for (const preset of [directPreset, directHighVolumePreset, discoverPreset]) {
  for (const source of preset.sources) {
    sourceByUrl.set(source.url, source);
  }
}

const sources = [...sourceByUrl.values()];

const reviewedOn = directPreset.checkedOn ?? "date not recorded";

const tool = findTool("gumroad-fees");

const breadcrumbs = toolBreadcrumbs(tool.id);

const directPlatform = directPreset.components[0];

const discoverComponent = discoverPreset.components[0];

if (!directPlatform || !discoverComponent) {
  throw new Error("A Gumroad fee preset has no fee components.");
}

const description = `Estimate Gumroad fees on direct sales (${formatFeeRate(directPlatform)} plus card processing) and Discover sales (${formatFeeRate(discoverComponent)}), what you keep, and what to charge to net a target.`;

const directNote = "Supported scenario: US Gumroad creator account, USD direct sale paid by credit card, before the documented $20,000 calendar-month volume threshold.";

const lineItemRow = "mt-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 text-sm text-paper/70";
---
<Layout title="Gumroad Fee Calculator: Direct & Discover | MathMyRate" description={description} ogImage="/og/gumroad.png" breadcrumbs={breadcrumbs} applicationName={tool.name}>
  <main id="main-content" class="mx-auto max-w-6xl px-5 py-8 md:px-8 md:py-10">
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="display mt-3 text-3xl font-bold md:text-4xl">{tool.name}</h1>
    <p class="mt-2 max-w-2xl leading-relaxed text-ink/70">Gumroad's cut, worked out in cents, for direct sales and Discover marketplace sales.</p>
    <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_.85fr]">
      <form id="gumroad-fee-form" data-calculator-form class="print-card rounded-[1.5rem] border border-line bg-[#fafbfd] p-6 shadow-[0_16px_45px_rgba(19,31,51,.08)] md:p-8" novalidate>
        <div class="flex items-baseline justify-between gap-3"><h2 class="display text-2xl font-bold">Sale details</h2><span class="shrink-0 text-xs text-ink/50">USD / per transaction</span></div>
        <p id="scenario-note" class="mt-2 text-sm text-ink/60">{directNote}</p>
        <div data-error-summary role="alert" hidden class="mt-5 rounded-lg border border-[#d99c89] bg-[#fff0e9] p-3 text-sm text-[#8f3c2d]"></div>
        <fieldset class="mt-6">
          <legend class="text-sm font-semibold">What kind of sale was it?</legend>
          <div class="mt-3 grid gap-2 sm:grid-cols-3">
            <label class="flex items-start gap-3 rounded-lg border border-line bg-paper px-4 py-3 text-sm font-medium"><input type="radio" name="scenario" value="direct" class="mt-1" checked /><span>Direct sale<span class="mt-1 block text-xs font-normal text-ink/55">From your profile or a direct link, before the volume threshold.</span></span></label>
            <label class="flex items-start gap-3 rounded-lg border border-line bg-paper px-4 py-3 text-sm font-medium"><input type="radio" name="scenario" value="direct-high-volume" class="mt-1" /><span>Direct sale after threshold<span class="mt-1 block text-xs font-normal text-ink/55">Your month already passed $20,000 in paid sales.</span></span></label>
            <label class="flex items-start gap-3 rounded-lg border border-line bg-paper px-4 py-3 text-sm font-medium"><input type="radio" name="scenario" value="discover" class="mt-1" /><span>Discover sale<span class="mt-1 block text-xs font-normal text-ink/55">The customer found the product through Gumroad's Discover marketplace.</span></span></label>
          </div>
        </fieldset>
        <fieldset class="mt-6">
          <legend class="text-sm font-semibold">What do you want to work out?</legend>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            <label class="flex items-start gap-3 rounded-lg border border-line bg-paper px-4 py-3 text-sm font-medium"><input type="radio" name="feeMode" value="received" class="mt-1" checked /><span>Customer paid an amount<span class="mt-1 block text-xs font-normal text-ink/55">See the fee and what you keep.</span></span></label>
            <label class="flex items-start gap-3 rounded-lg border border-line bg-paper px-4 py-3 text-sm font-medium"><input type="radio" name="feeMode" value="net" class="mt-1" /><span>I want to keep a target<span class="mt-1 block text-xs font-normal text-ink/55">Find what to charge for it.</span></span></label>
          </div>
        </fieldset>
        <NumberField class="mt-6" id="amount" label="Amount the customer paid" labelTextId="amount-label" value="100.00" unit="usd" required help="The customer's full order amount." />
        <div class="calculator-actions mt-7 flex flex-wrap gap-3"><button class="rounded-full bg-ink px-5 py-2.5 text-sm font-bold text-paper" type="button" id="gumroad-fee-update">Update fees</button><button id="gumroad-fee-reset" class="rounded-full border border-line px-5 py-2.5 text-sm font-semibold" type="button">Reset example</button></div>
      </form>
      <aside id="fee-panel" data-result-panel aria-live="polite" class="print-card h-fit rounded-[1.5rem] bg-ink p-7 text-paper shadow-[0_16px_45px_rgba(19,31,51,.16)] md:p-9">
        <p class="eyebrow !text-[#c3d2ea]" id="primary-label" data-primary-label>You keep from this sale</p>
        <p id="fee-result" data-primary-result class="result-value display mt-4 text-6xl font-bold">{formatUsdGrouped(exampleSale.sellerProceedsCents)}</p>
        <p class="mt-1 text-paper/70">before expenses and income tax</p>
        <div class="my-7 border-t border-paper/25"></div>
        <div class="[&>:first-child]:mt-0">
          <ResultRow label="Gumroad fee" valueId="fee-total-result" value={formatUsdGrouped(exampleSale.feeCents)} />
          <div id="line-items" class="mt-1">{exampleSale.lineItems.map((item) => <div class={lineItemRow}><span>{item.label}</span><strong class="ml-auto text-right text-paper">{formatUsdGrouped(item.feeCents)}</strong></div>)}</div>
          <ResultRow label="Net after fees" valueId="net-result" value={formatUsdGrouped(exampleSale.netAfterFeesCents)} />
          <ResultRow label="You keep from that charge" valueId="keep-result" value="—" rowId="keep-row" hidden />
        </div>
        <div class="calculator-actions mt-8 flex flex-wrap gap-2"><button id="copy-fee" type="button" class="rounded-full bg-paper px-4 py-2.5 text-sm font-bold text-ink">Copy result</button><button type="button" data-print class="rounded-full border border-paper/35 px-4 py-2.5 text-sm font-bold">Print</button></div>
        <ul class="mt-6 list-disc space-y-1 pl-5 text-sm text-[#ccd8ec]">{exampleSale.warnings.map((warning) => <li>{warning}</li>)}</ul>
        <p id="fee-message" class="mt-4 text-sm text-[#ccd8ec]" aria-live="polite"></p>
      </aside>
    </div>
    <StickyResult />
    <noscript><p class="mt-5 rounded-lg border border-line bg-mist p-4 text-sm">JavaScript is required to update this calculator. The worked example above uses a $100.00 direct sale before Gumroad's monthly volume threshold; enable JavaScript to calculate your own amounts locally.</p></noscript>
    <section class="mt-14 max-w-3xl border-t border-line pt-10">
      <h2 class="display text-3xl font-bold">Where this rate comes from</h2>
      <p class="mt-4 leading-relaxed text-ink/70">Gumroad documents two sale kinds with separate pricing. A direct sale from your profile or a direct link pays 10% + $0.50 to Gumroad plus 2.9% + $0.30 in credit-card processing. A sale through the Discover marketplace pays a flat 30% that already includes processing. Once an account has reached $20,000 in paid sales in a calendar month, the direct-sale fee drops to 5% + $0.50 while card processing stays separate. Results are estimates rounded to the nearest cent; Gumroad's published pages do not establish a component-rounding policy.</p>
      <p class="mt-4 leading-relaxed text-ink/70">One gap is documented on purpose: a direct sale that itself crosses the $20,000 monthly threshold. {thresholdPreset.blockedReason} This tool refuses that case instead of inventing a blended rate; use the pre-threshold or post-threshold scenario once the month's state is known.</p>
      <p class="mt-4 leading-relaxed text-ink/70">Sales tax is never calculated here. Gumroad's own sales-tax handling on these sale kinds is outside the documented scenarios below, so no tax input is offered and no tax row appears.</p>
      {scenarioDocs.map((doc) => (<div class="mt-8"><h3 class="display text-xl font-bold">{doc.heading}</h3><h4 class="mt-3 text-sm font-semibold uppercase tracking-wide text-ink/60">Stated assumptions</h4><ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed text-ink/70">{doc.preset.assumptions.map((assumption) => <li>{assumption}</li>)}</ul><h4 class="mt-4 text-sm font-semibold uppercase tracking-wide text-ink/60">Not covered</h4><ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed text-ink/70">{doc.preset.exclusions.map((exclusion) => <li>{exclusion}</li>)}</ul></div>))}
      <p class="mt-8 text-sm text-ink/60">Official sources: {sources.map((source, index) => <span>{index > 0 && " "}<a class="underline" href={source.url} rel="noopener">{source.title}</a></span>)}. Reviewed {reviewedOn}. Rates can change; unsupported cases are refused rather than estimated.</p>
    </section>
    <RelatedTools current={tool.id} />
  </main>
  <script>
    import {
      calculateFees,
      getFeePreset,
      grossUpFees,
      type FeePreset,
    } from "@MathMyRate/calculators";
    import {
      type CalculationTrigger,
      formatUsdGrouped,
      focusProblemField,
      InputProblem,
      markResultsCurrent,
      markResultsStale,
      requireHtmlButton,
      requireHtmlElement,
      requireHtmlForm,
      requireHtmlInput,
      setFieldState,
      shouldDeferProblem,
      usdToCents,
      watchCalculatorFields,
    } from "../../scripts/calculator-form";

    function requirePreset(id: string): FeePreset {
      const preset = getFeePreset(id);

      if (!preset) {
        throw new Error(`The ${id} fee preset is missing from the registry.`);
      }

      return preset;
    }

    const PRESETS = {
      direct: requirePreset("gumroad-us-direct-card"),
      "direct-high-volume": requirePreset("gumroad-us-direct-card-high-volume"),
      discover: requirePreset("gumroad-us-discover"),
    } as const;

    const SCENARIOS = {
      direct: {
        label: "Gumroad direct sale",
        note: "Supported scenario: US Gumroad creator account, USD direct sale paid by credit card, before the documented $20,000 calendar-month volume threshold.",
      },
      "direct-high-volume": {
        label: "Gumroad direct sale after the monthly threshold",
        note: "Supported scenario: US Gumroad creator account, USD direct credit-card sale, after the account passed $20,000 in paid sales this calendar month.",
      },
      discover: {
        label: "Gumroad Discover marketplace sale",
        note: "Supported scenario: US Gumroad creator account, USD sale made through Gumroad's Discover marketplace.",
      },
    } as const;

    type ScenarioId = keyof typeof SCENARIOS;

    const MODE_TEXT = {
      received: {
        amountLabel: "Amount the customer paid",
        amountHelp: "The customer's full order amount.",
        primaryLabel: "You keep from this sale",
      },
      net: {
        amountLabel: "Amount you want to keep",
        amountHelp: "What should reach you after Gumroad's fee.",
        primaryLabel: "Charge the customer",
      },
    } as const;

    type FeeMode = keyof typeof MODE_TEXT;

    const form = requireHtmlForm("gumroad-fee-form");

    const panel = requireHtmlElement("fee-panel");

    const copyButton = requireHtmlButton("copy-fee");

    let latestCopy: string | null = null;

    function currentMode(): FeeMode {
      const checked = form.querySelector('input[name="feeMode"]:checked');

      return checked instanceof HTMLInputElement && checked.value === "net" ? "net" : "received";
    }

    function currentScenario(): ScenarioId {
      const checked = form.querySelector('input[name="scenario"]:checked');
      const value = checked instanceof HTMLInputElement ? checked.value : "direct";

      return value === "direct-high-volume"
        ? "direct-high-volume"
        : value === "discover"
          ? "discover"
          : "direct";
    }

    function setResult(id: string, text: string): void {
      requireHtmlElement(id).textContent = text;
    }

    function applyModeText(mode: FeeMode): void {
      const text = MODE_TEXT[mode];

      requireHtmlElement("amount-label").textContent = text.amountLabel;
      requireHtmlElement("amount-help").textContent = text.amountHelp;
      requireHtmlElement("primary-label").textContent = text.primaryLabel;
      requireHtmlElement("keep-row").hidden = mode !== "net";
    }

    function applyScenarioText(scenario: ScenarioId): void {
      requireHtmlElement("scenario-note").textContent = SCENARIOS[scenario].note;
    }

    function renderLineItems(items: ReadonlyArray<{ label: string; feeCents: bigint }>): void {
      const container = requireHtmlElement("line-items");

      container.replaceChildren();

      for (const item of items) {
        const row = document.createElement("div");
        row.className = "mt-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 text-sm text-paper/70";

        const label = document.createElement("span");
        label.textContent = item.label;

        const value = document.createElement("strong");
        value.className = "ml-auto text-right text-paper";
        value.textContent = formatUsdGrouped(item.feeCents);

        row.appendChild(label);
        row.appendChild(value);
        container.appendChild(row);
      }
    }

    function clear(): void {
      for (const id of ["fee-result", "fee-total-result", "net-result", "keep-result"]) {
        setResult(id, "—");
      }

      renderLineItems([]);
      markResultsCurrent(panel, []);
      copyButton.disabled = true;
      latestCopy = null;
    }

    function calc(trigger: CalculationTrigger): void {
      const mode = currentMode();
      const scenario = currentScenario();
      const preset = PRESETS[scenario];

      try {
        const amount = usdToCents(requireHtmlInput("amount").value, "amount");

        const result =
          mode === "received"
            ? calculateFees({ preset, grossCents: amount })
            : grossUpFees({ preset, targetProceedsCents: amount });

        setResult(
          "fee-result",
          formatUsdGrouped(mode === "received" ? result.sellerProceedsCents : result.grossCents),
        );
        setResult("fee-total-result", formatUsdGrouped(result.feeCents));
        setResult("net-result", formatUsdGrouped(result.netAfterFeesCents));
        renderLineItems(result.lineItems);

        const reviewed = result.checkedOn ?? "date not recorded";

        if (mode === "net") {
          setResult("keep-result", formatUsdGrouped(result.sellerProceedsCents));
        }

        latestCopy =
          mode === "received"
            ? `${SCENARIOS[scenario].label} on ${formatUsdGrouped(result.grossCents)}: ${formatUsdGrouped(result.feeCents)} fee, you keep ${formatUsdGrouped(result.sellerProceedsCents)} (estimate; source reviewed ${reviewed}).`
            : `To keep ${formatUsdGrouped(amount)} from a ${SCENARIOS[scenario].label}, charge ${formatUsdGrouped(result.grossCents)} (estimate; source reviewed ${reviewed}).`;

        markResultsCurrent(panel, [copyButton]);
        requireHtmlElement("fee-message").textContent = "";
        setFieldState(form);
      } catch (error) {
        const problem =
          error instanceof InputProblem
            ? error
            : new InputProblem(
                "amount",
                mode === "received"
                  ? "Enter an amount above zero."
                  : "This target cannot be reached. Try a smaller amount.",
              );

        if (shouldDeferProblem(form, trigger)) {
          markResultsStale(panel, [copyButton]);

          return;
        }

        clear();
        setFieldState(form, problem);

        if (trigger === "submit") focusProblemField(form, problem);
      }
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      calc("submit");
    });

    requireHtmlButton("gumroad-fee-update").addEventListener("click", () => calc("submit"));

    form.querySelectorAll('input[name="feeMode"]').forEach((element) => {
      element.addEventListener("change", () => {
        applyModeText(currentMode());
        calc("commit");
      });
    });

    form.querySelectorAll('input[name="scenario"]').forEach((element) => {
      element.addEventListener("change", () => {
        applyScenarioText(currentScenario());
        calc("commit");
      });
    });

    watchCalculatorFields(form, calc);

    requireHtmlButton("gumroad-fee-reset").addEventListener("click", () => {
      form.reset();
      applyScenarioText(currentScenario());
      applyModeText(currentMode());
      calc("commit");
    });

    copyButton.addEventListener("click", async () => {
      if (latestCopy === null) return;

      try {
        await navigator.clipboard.writeText(latestCopy);
        requireHtmlElement("fee-message").textContent = "Result copied.";
      } catch {
        requireHtmlElement("fee-message").textContent =
          "Copy was unavailable. Select the result to copy it manually.";
      }
    });

    applyScenarioText(currentScenario());

    applyModeText(currentMode());

    calc("commit");
  </script>
</Layout>
