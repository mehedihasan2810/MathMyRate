---
import { calculateFees, type FeePreset } from "@MathMyRate/calculators";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DataTable from "../../components/DataTable.astro";
import EmbedSnippet from "../../components/EmbedSnippet.astro";
import FaqSection from "../../components/FaqSection.astro";
import FeeCalculator from "../../components/FeeCalculator.astro";
import FeeRuleDetails from "../../components/FeeRuleDetails.astro";
import PageByline from "../../components/PageByline.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import { findTool, toolBreadcrumbs } from "../../data/tools";
import Layout from "../../layouts/Layout.astro";
import { formatSaleLabel, requireOfficialPreset } from "../../lib/fee-tables";
import type { FaqEntry } from "../../lib/structured-data";
import { formatUsdGrouped } from "../../scripts/calculator-form";

const tool = findTool("teachable-fees");

const breadcrumbs = toolBreadcrumbs(tool.id);

const starter = requireOfficialPreset("teachable-us-starter-card");

const paid = requireOfficialPreset("teachable-us-paid-plan-card");

const starterSubscription = requireOfficialPreset("teachable-us-starter-subscription");

const fee = (preset: FeePreset, grossCents: bigint): string => formatUsdGrouped(calculateFees({ preset, grossCents }).feeCents);

const keep = (preset: FeePreset, grossCents: bigint): string => formatUsdGrouped(calculateFees({ preset, grossCents }).sellerProceedsCents);

const keepRows = [2_900n, 4_900n, 9_900n, 19_900n, 49_900n, 99_700n].map((grossCents) => [formatSaleLabel(grossCents), fee(starter, grossCents), keep(starter, grossCents), fee(paid, grossCents), keep(paid, grossCents)]);

// Plan prices from Teachable's pricing page.
const starterMonthlyCents = 3_900n;

const builderMonthlyCents = 8_900n;

const starterRateBps = BigInt(starter.components.find((component) => component.id === "teachable-plan")?.rateBps ?? 0);

const planBreakEvenCents = ((builderMonthlyCents - starterMonthlyCents) * 10_000n + starterRateBps - 1n) / starterRateBps;

const updatedOn = "2026-09-16";

const guideSources = [
  { title: "Pricing | Teachable", url: "https://teachable.com/pricing" },
  { title: "Understand your transaction fees and bundles | Teachable Support", url: "https://support.teachable.com/en/articles/15661316-understand-your-transaction-fees-and-bundles" },
];

const faq: readonly FaqEntry[] = [
  { question: "What does Teachable charge per sale?", answer: `The Starter plan adds a 7.5% transaction fee on all sales; Builder, Growth, and Advanced add none. Card processing is 2.9% + $0.30 for a US card either way. A $99 course sale pays ${fee(starter, 9_900n)} on Starter and ${fee(paid, 9_900n)} on a paid plan.` },
  { question: "When does a bigger plan pay for itself?", answer: `Builder costs $50 a month more than Starter and removes the 7.5% fee, so on fees alone it wins once your sales pass ${formatSaleLabel(planBreakEvenCents)} a month.` },
  { question: "Do subscriptions cost more?", answer: `Yes. Teachable's Standard bundle adds 0.7% to recurring transactions, so a $99 subscription payment on Starter pays ${fee(starterSubscription, 9_900n)} instead of ${fee(starter, 9_900n)}. The Global bundle replaces that and the tax fee with a flat 2.8%.` },
  { question: "What about sales tax?", answer: "Teachable's Standard bundle adds 0.5% to transactions where tax is assessed, so this calculator covers sales without tax. Teachable collects and remits tax on its own gateway." },
  { question: "What does an international card cost?", answer: "Teachable's pages disagree: its pricing page says 3.9% + 30¢ and its fee article says 4.4% + $0.30. Because the two official figures differ, international cards are not estimated here." },
  { question: "Can I use my own Stripe account?", answer: "Yes, through a custom payment gateway, but Teachable adds a 2% integration fee for US schools on top, which this calculator does not cover." },
  { question: "Is there a free Teachable plan?", answer: "No. Teachable lists a 7-day free trial and a 30-day money-back guarantee, with Starter at $39 a month, Builder at $89, and Growth at $189, or 22% less billed yearly." },
];
---
<Layout title="Teachable Fee Calculator: Plan and Processing Fees | MathMyRate" description="Estimate Teachable's 7.5% Starter transaction fee or the no-fee plans, with 2.9% + 30¢ card processing and the 0.7% fee on subscription payments." ogImage="/og/teachable.png" breadcrumbs={breadcrumbs} applicationName={tool.name}>
  <main id="main-content" class="mx-auto max-w-6xl px-5 py-8 md:px-8 md:py-10">
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="display mt-3 text-3xl font-bold md:text-4xl">{tool.name}</h1>
    <p class="mt-2 max-w-2xl leading-relaxed text-ink/70">See what Teachable's plan fee and card processing take from a course, coaching, or membership sale, and when a bigger plan costs less.</p>
    <PageByline updatedOn={updatedOn} reviewedOn={starter.checkedOn} />
    <FeeCalculator calculatorId="teachable" />
    <article class="guide mt-14 border-t border-line pt-4">
      <h2>What this calculator tells you</h2>
      <p>Teachable charges a plan fee on top of card processing. A <strong>$99</strong> sale pays <strong>{fee(starter, 9_900n)}</strong> on the Starter plan, which adds 7.5%, and <strong>{fee(paid, 9_900n)}</strong> on Builder or Growth, which add nothing. Card processing is 2.9% + $0.30 for a US card on either plan, and the monthly plan price is separate.</p>

      <h2>Teachable's plans and fees</h2>
      <ul>
        <li><strong>Starter, $39 a month:</strong> 7.5% transaction fee on all sales.</li>
        <li><strong>Builder, $89 a month; Growth, $189:</strong> no Teachable transaction fee.</li>
        <li><strong>Processing:</strong> 2.9% + $0.30 for a US card through Teachable Payments.</li>
        <li><strong>Standard bundle extras:</strong> 0.7% on recurring transactions, and 0.5% where tax is assessed. The Global bundle replaces both with a flat 2.8%.</li>
      </ul>
      <p>Billed yearly, Teachable's prices drop 22%. There is no free plan: Teachable lists a 7-day trial and a 30-day money-back guarantee.</p>

      <h2>What you keep at common prices</h2>
      <p>One-time sales by US card, with no tax assessed.</p>
      <DataTable caption="Teachable fees and what you keep, by sale price" headers={["Sale", "Starter fee", "Starter keeps", "Paid plan fee", "Paid plan keeps"]} rows={keepRows} />

      <h2>When Builder beats Starter</h2>
      <p>Builder costs $50 a month more and removes the 7.5% fee, so counting fees alone it wins once your sales pass <strong>{formatSaleLabel(planBreakEvenCents)}</strong> a month. Below that, Starter's lower monthly price costs less overall.</p>

      <h2>What this leaves out</h2>
      <ul>
        <li><strong>International cards:</strong> Teachable's pricing page says 3.9% + 30¢ and its fee article says 4.4% + $0.30, so neither is used here.</li>
        <li><strong>PayPal</strong>, the Global bundle's flat 2.8%, and a custom payment gateway, which adds 2% for US schools.</li>
        <li><strong>Affiliate and author payouts, refunds, and the $15 chargeback fee.</strong></li>
      </ul>
      <p>Comparing platforms? See <a href="/fees/creator-platform-fees/">creator platform fees compared</a>.</p>

      <FeeRuleDetails calculatorId="teachable" />

      <FaqSection entries={faq} />

      <EmbedSnippet toolId="teachable-fees" />

      <h2>Sources</h2>
      <ul class="text-base">{guideSources.map((source) => <li><a href={source.url} rel="noopener">{source.title}</a></li>)}</ul>
      <p class="text-sm text-ink/60">Teachable's pages were reviewed on the date shown at the top of this page. MathMyRate is not affiliated with Teachable. See <a href="/methodology/">how the numbers are made</a> and the <a href="/changelog/">changelog</a>.</p>
    </article>
    <RelatedTools current={tool.id} />
  </main>
</Layout>
