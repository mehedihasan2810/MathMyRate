---
import { calculateFees, grossUpFees } from "@MathMyRate/calculators";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DataTable from "../../components/DataTable.astro";
import EmbedSnippet from "../../components/EmbedSnippet.astro";
import FaqSection from "../../components/FaqSection.astro";
import FeeCalculator from "../../components/FeeCalculator.astro";
import FeeRuleDetails from "../../components/FeeRuleDetails.astro";
import PageByline from "../../components/PageByline.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import { findFeeCalculator } from "../../data/fee-calculators";
import { findTool, toolBreadcrumbs } from "../../data/tools";
import Layout from "../../layouts/Layout.astro";
import { formatCombinedRate } from "../../lib/fee-labels";
import { commonSaleAmounts, feeFor, feeRowsByAmount, requireOfficialPreset, scenarioRowsAt } from "../../lib/fee-tables";
import type { FaqEntry } from "../../lib/structured-data";
import { formatUsdGrouped } from "../../scripts/calculator-form";

const tool = findTool("paypal-fees");

const breadcrumbs = toolBreadcrumbs(tool.id);

const config = findFeeCalculator("paypal");

const checkout = requireOfficialPreset("paypal-us-checkout-paypal-payment");

const card = requireOfficialPreset("paypal-us-standard-card-payment");

const international = requireOfficialPreset("paypal-us-checkout-international");

const rate = formatCombinedRate(checkout.components);

const cardRate = formatCombinedRate(card.components);

const sale = calculateFees({ preset: checkout, grossCents: 10000n });

const internationalSale = calculateFees({ preset: international, grossCents: 10000n });

const target = grossUpFees({ preset: checkout, targetProceedsCents: 10000n });

const fee = formatUsdGrouped(sale.feeCents);

const kept = formatUsdGrouped(sale.sellerProceedsCents);

const amountRows = feeRowsByAmount(checkout, commonSaleAmounts);

const scenarioRows = scenarioRowsAt(config.scenarios, 10000n);

const updatedOn = "2026-09-15";

const title = `${tool.name} (${rate}) | MathMyRate`;

const description = `Estimate PayPal's ${rate} Checkout fee, card, invoice, international, and QR code fees, what you keep, and what to charge to net a target.`;

const guideSources = [
  { title: "PayPal Merchant Fees (last updated by PayPal on September 1, 2026)", url: "https://www.paypal.com/us/business/paypal-business-fees" },
  { title: "PayPal User Agreement", url: "https://www.paypal.com/us/legalhub/paypal/useragreement-full" },
];

const faq: readonly FaqEntry[] = [
  { question: "What is PayPal's fee for receiving a payment?", answer: `It depends on the product. For a US Business account receiving a domestic payment in USD, PayPal Checkout costs ${rate}, standard card payments cost ${cardRate}, and QR code payments cost 2.29% + 9¢. Invoices use the Checkout or card rate depending on how the customer pays.` },
  { question: "Are card payments cheaper than PayPal Checkout?", answer: `At PayPal's published rates, yes. Standard card payments cost ${cardRate} and PayPal Checkout costs ${rate}, so a $100 sale pays ${feeFor("paypal-us-standard-card-payment", 10000n)} by card and ${fee} through Checkout.` },
  { question: "Does PayPal return its fee when I refund a customer?", answer: "No. PayPal charges no fee to make a refund, but the fees you paid to receive the original payment are not returned, for both full and partial refunds." },
  { question: "How much are PayPal's dispute and chargeback fees?", answer: "PayPal's standard dispute fee is 15.00 USD, or 30.00 USD for high-volume dispute accounts. Card chargebacks on transactions not processed through a PayPal account or guest checkout carry a 20.00 USD chargeback fee." },
  { question: "Can I avoid fees with Friends and Family payments?", answer: "Not for sales. PayPal's User Agreement says personal transactions must not be used to pay for goods or services, and business accounts cannot receive them." },
  { question: "How much does PayPal charge for invoices?", answer: `An invoice paid through PayPal Checkout, Venmo, or guest checkout costs ${rate}. An invoice paid by card, Apple Pay, or another wallet costs ${cardRate}. Pay Later costs 4.99% plus the fixed fee, and Pay by Bank costs 1%, capped at $10.00.` },
  { question: "What does PayPal charge for international payments?", answer: `PayPal adds 1.50% to the domestic fee when the buyer and seller are residents of different markets. A $100 international Checkout payment pays ${formatUsdGrouped(internationalSale.feeCents)}. A currency conversion adds a spread to the exchange rate as well, which this calculator does not include.` },
  { question: "How do I charge enough to cover PayPal's fee?", answer: `Choose I want to keep a target and enter the amount you want to receive. To keep $100.00 from a PayPal Checkout payment, charge ${formatUsdGrouped(target.grossCents)}.` },
  { question: "Does it cost money to move PayPal money to my bank?", answer: "A standard transfer to a linked bank account is free when no currency conversion is involved. An instant transfer from a Business account costs 1.50% of the amount, with a 0.50 USD minimum fee." },
];
---
<Layout title={title} description={description} ogImage="/og/paypal.png" breadcrumbs={breadcrumbs} applicationName={tool.name}>
  <main id="main-content" class="mx-auto max-w-6xl px-5 py-8 md:px-8 md:py-10">
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="display mt-3 text-3xl font-bold md:text-4xl">{tool.name}</h1>
    <p class="mt-2 max-w-2xl leading-relaxed text-ink/70">PayPal's fee, out in the open, for Checkout, card, invoice, international, and QR code payments.</p>
    <PageByline updatedOn={updatedOn} reviewedOn={checkout.checkedOn} />
    <FeeCalculator calculatorId="paypal" />
    <article class="guide mt-14 border-t border-line pt-4">
      <h2>What this calculator tells you</h2>
      <p>The PayPal fee calculator shows what PayPal keeps from a payment and what reaches you. PayPal prices each product separately. For a US Business account, a domestic PayPal Checkout payment costs <strong>{rate}</strong>, so a $100 sale pays <strong>{fee}</strong> and leaves <strong>{kept}</strong>. Standard card payments, invoices, international Checkout payments, and QR codes each have their own scenario.</p>

      <h2>How to use it</h2>
      <ol>
        <li>Choose how the customer paid: PayPal Checkout, a card, an invoice, an international Checkout payment, or a QR code.</li>
        <li>Choose whether you know what the customer paid, or what you want to keep.</li>
        <li>Enter the amount, and any sales tax you collected so it is not counted as yours.</li>
        <li>To see monthly and yearly totals, enter how many same-size sales you make a month.</li>
      </ol>

      <h2>How the fee is built</h2>
      <p>Here is a $100.00 PayPal Checkout payment, using the same code as the calculator.</p>
      <ol>
        <li><strong>Percentage.</strong> 3.49% of $100.00 is $3.49.</li>
        <li><strong>Fixed fee.</strong> PayPal's fixed fee for payments received in US dollars is 49¢, so the fee is {fee} and you keep {kept}.</li>
        <li><strong>International buyer.</strong> PayPal adds 1.50% when buyer and seller are in different markets, for a total of {formatUsdGrouped(internationalSale.feeCents)}.</li>
        <li><strong>Working backward.</strong> To keep $100.00 from a Checkout payment, charge {formatUsdGrouped(target.grossCents)}.</li>
      </ol>

      <h2>PayPal Checkout fees at common sale amounts</h2>
      <p>Domestic PayPal Checkout payments. The fixed 49¢ takes a bigger share of small sales.</p>
      <DataTable caption={`PayPal Checkout fee (${rate}) by sale amount`} headers={["Sale", "PayPal fee", "You keep", "Fee share"]} rows={amountRows} />

      <h2>The same $100 sale in every scenario</h2>
      <DataTable caption="PayPal fee on a $100 payment by payment type" headers={["Scenario", "Rate", "PayPal fee", "You keep"]} rows={scenarioRows} />

      <h2>Other PayPal fees this calculator does not add</h2>
      <p>From PayPal's merchant fees page and User Agreement, for US Business accounts.</p>
      <ul>
        <li><strong>Pay Later:</strong> 4.99% plus the fixed fee.</li>
        <li><strong>Advanced Credit and Debit Card Payments:</strong> 2.89% + 0.29 USD, subject to PayPal's application and approval.</li>
        <li><strong>Micropayments:</strong> 4.99% + 0.09 USD, for accounts approved for that pricing.</li>
        <li><strong>Invoices:</strong> Pay by Bank costs 1%, capped at $10.00, and an optional Invoice Subscription costs 14.99 USD a month.</li>
        <li><strong>Currency conversion:</strong> a spread of 3.00% or 4.00% built into the exchange rate, depending on the transaction.</li>
        <li><strong>Disputes and chargebacks:</strong> a 15.00 USD standard dispute fee, 30.00 USD for high-volume dispute accounts, and a 20.00 USD chargeback fee on card transactions not processed through a PayPal account or guest checkout.</li>
        <li><strong>Refunds:</strong> no fee to refund, but the original fees are not returned.</li>
        <li><strong>Instant transfers:</strong> 1.50% of the amount, with a 0.50 USD minimum. Standard transfers to a linked bank are free without currency conversion.</li>
      </ul>

      <FeeRuleDetails calculatorId="paypal" />

      <FaqSection entries={faq} />

      <EmbedSnippet toolId="paypal-fees" />

      <h2>Sources</h2>
      <ul class="text-base">{guideSources.map((source) => <li><a href={source.url} rel="noopener">{source.title}</a></li>)}</ul>
      <p class="text-sm text-ink/60">PayPal's pages were reviewed on the date shown at the top of this page. Custom pricing can differ. MathMyRate is not affiliated with PayPal. See <a href="/methodology/">how the numbers are made</a> and the <a href="/changelog/">changelog</a>.</p>
    </article>
    <RelatedTools current={tool.id} />
  </main>
</Layout>
