---
import { calculateFees, getFeePreset } from "@MathMyRate/calculators";
import Layout from "../../layouts/Layout.astro";
import { formatUsdGrouped } from "../../scripts/calculator-form";

const preset = getFeePreset("paypal-us-checkout-paypal-payment");

if (!preset) {
  throw new Error("The PayPal fee preset is missing from the registry.");
}

const component = preset.components[0];

if (!component) {
  throw new Error("The PayPal fee preset has no fee components.");
}

const exampleSale = calculateFees({ preset, grossCents: 10000n });

const ratePercent = component.rateBps / 100;

const fixedFee = formatUsdGrouped(BigInt(component.fixedCents));

const reviewedOn = preset.checkedOn ?? "date not recorded";
---
<Layout title="PayPal Fee Calculator | MathMyRate" description="Estimate PayPal Checkout's PayPal payment fee, what you keep from a sale, and what to charge to net a target amount." ogImage="/og/paypal.png">
  <main id="main-content" class="mx-auto max-w-6xl px-5 py-12 md:px-8 md:py-16">
    <div class="max-w-2xl"><p class="eyebrow">Platform fees / 02</p><h1 class="display mt-4 text-5xl font-bold leading-none md:text-6xl">PayPal's fee, out in the open.</h1><p class="mt-5 text-lg leading-relaxed text-ink/70">PayPal Checkout's PayPal payment pricing, applied with exact cents: see what a sale costs, or work backwards from what you want to keep.</p></div>
    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_.85fr]">
      <form id="paypal-fee-form" class="print-card rounded-[1.5rem] border border-line bg-[#faf8f1] p-6 shadow-[0_16px_45px_rgba(56,71,61,.08)] md:p-8" novalidate>
        <div class="flex items-baseline justify-between"><h2 class="display text-2xl font-bold">Payment details</h2><span class="mono text-xs text-ink/50">USD / per transaction</span></div>
        <p class="mt-2 text-sm text-ink/60">Supported scenario: US PayPal Business account, USD, PayPal Checkout paid with the buyer's PayPal payment method.</p>
        <div data-error-summary role="alert" hidden class="mt-5 rounded-lg border border-[#d99c89] bg-[#fff0e9] p-3 text-sm text-[#8f3c2d]"></div>
        <fieldset class="mt-6">
          <legend class="text-sm font-semibold">What do you want to work out?</legend>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            <label class="flex items-start gap-3 rounded-lg border border-line bg-paper px-4 py-3 text-sm font-medium"><input type="radio" name="feeMode" value="received" class="mt-1" checked /><span>Customer paid an amount<span class="mt-1 block text-xs font-normal text-ink/55">See the fee and what you keep.</span></span></label>
            <label class="flex items-start gap-3 rounded-lg border border-line bg-paper px-4 py-3 text-sm font-medium"><input type="radio" name="feeMode" value="net" class="mt-1" /><span>I want to keep a target<span class="mt-1 block text-xs font-normal text-ink/55">Find what to charge for it.</span></span></label>
          </div>
        </fieldset>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          <label class="text-sm font-semibold"><span id="amount-label">Amount the customer paid</span> <input id="amount" data-field="amount" aria-describedby="amount-help amount-error" inputmode="decimal" value="100.00" class="mt-2 w-full rounded-lg border border-line bg-paper px-3 py-3 text-base font-medium" /><span id="amount-help" class="mt-1 block text-xs font-normal text-ink/55">The full amount processed, including any sales tax you collected.</span><span id="amount-error" class="field-error" role="alert"></span></label>
          <label class="text-sm font-semibold">Sales tax collected (optional) <input id="taxIncluded" data-field="taxIncluded" aria-describedby="taxIncluded-help taxIncluded-error" inputmode="decimal" value="" class="mt-2 w-full rounded-lg border border-line bg-paper px-3 py-3 text-base font-medium" placeholder="0.00" /><span id="taxIncluded-help" class="mt-1 block text-xs font-normal text-ink/55">A pass-through you enter; this calculator never computes tax. The fee applies to the amount that includes it.</span><span id="taxIncluded-error" class="field-error" role="alert"></span></label>
        </div>
        <div class="calculator-actions mt-7 flex flex-wrap gap-3"><button class="rounded-full bg-ink px-5 py-2.5 text-sm font-bold text-paper" type="submit">Update fees</button><button id="paypal-fee-reset" class="rounded-full border border-line px-5 py-2.5 text-sm font-semibold" type="button">Reset example</button></div>
      </form>
      <aside aria-live="polite" class="print-card h-fit rounded-[1.5rem] bg-ink p-7 text-paper shadow-[0_16px_45px_rgba(56,71,61,.16)] md:p-9">
        <p class="eyebrow !text-[#c6d9c6]" id="primary-label">You keep from this sale</p>
        <p id="fee-result" class="result-value display mt-4 text-6xl font-bold">{formatUsdGrouped(exampleSale.sellerProceedsCents)}</p>
        <p class="mt-1 text-paper/70">before expenses and income tax</p>
        <div class="my-7 border-t border-paper/25"></div>
        <div class="flex justify-between"><span class="text-paper/70">PayPal fee</span><strong id="fee-total-result">{formatUsdGrouped(exampleSale.feeCents)}</strong></div>
        <div class="mt-4 flex justify-between"><span class="text-paper/70">Net after fees</span><strong id="net-result">{formatUsdGrouped(exampleSale.netAfterFeesCents)}</strong></div>
        <div class="mt-4 flex justify-between" id="tax-row" hidden><span class="text-paper/70">Sales tax collected</span><strong id="tax-result">—</strong></div>
        <div class="mt-4 flex justify-between" id="keep-row" hidden><span class="text-paper/70">You keep after fees and tax</span><strong id="keep-result">—</strong></div>
        <div class="calculator-actions mt-8 flex flex-wrap gap-2"><button id="copy-fee" type="button" class="rounded-full bg-paper px-4 py-2.5 text-sm font-bold text-ink">Copy result</button><button type="button" onclick="window.print()" class="rounded-full border border-paper/35 px-4 py-2.5 text-sm font-bold">Print</button></div>
        <ul class="mt-6 list-disc space-y-1 pl-5 text-sm text-[#d6e6d5]">{exampleSale.warnings.map((warning) => <li>{warning}</li>)}</ul>
        <p id="fee-message" class="mt-4 text-sm text-[#d6e6d5]" aria-live="polite"></p>
      </aside>
    </div>
    <noscript><p class="mt-5 rounded-lg border border-line bg-mist p-4 text-sm">JavaScript is required to update this calculator. The worked example above uses a $100.00 PayPal payment; enable JavaScript to calculate your own amounts locally.</p></noscript>
    <section class="mt-14 max-w-3xl border-t border-line pt-10">
      <h2 class="display text-3xl font-bold">Where this rate comes from</h2>
      <p class="mt-4 leading-relaxed text-ink/70">This tool covers exactly one documented scenario: a US PayPal Business account receiving a domestic USD commercial transaction through PayPal Checkout, where the buyer pays with PayPal's own payment method. The fee is one processing component: {ratePercent}% of the processed amount plus {fixedFee} per transaction. Results are estimates rounded to the nearest cent; PayPal's published pages do not establish a component-rounding policy.</p>
      <p class="mt-4 leading-relaxed text-ink/70">Sales tax is never calculated here. If you collected tax on the transaction, enter it yourself: it stays part of the processed amount, so the percentage fee applies to it, and it is not counted as your income. Card payments through PayPal Checkout are a different product with a different fee and are not covered here.</p>
      <h3 class="display mt-8 text-xl font-bold">Stated assumptions</h3>
      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm leading-relaxed text-ink/70">{preset.assumptions.map((assumption) => <li>{assumption}</li>)}</ul>
      <h3 class="display mt-8 text-xl font-bold">Not covered by this calculator</h3>
      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm leading-relaxed text-ink/70">{preset.exclusions.map((exclusion) => <li>{exclusion}</li>)}</ul>
      <p class="mt-8 text-sm text-ink/60">Official sources: {preset.sources.map((source, index) => <span>{index > 0 && " "}<a class="underline" href={source.url} rel="noopener">{source.title}</a></span>)}. Reviewed {reviewedOn}. Rates can change; unsupported cases are refused rather than estimated.</p>
    </section>
  </main>
  <script>
    import {
      calculateFees,
      getFeePreset,
      grossUpFees,
      type FeePreset,
    } from "@MathMyRate/calculators";
    import {
      formatUsdGrouped,
      InputProblem,
      requireHtmlButton,
      requireHtmlElement,
      requireHtmlForm,
      requireHtmlInput,
      setFieldState,
      usdToCents,
    } from "../../scripts/calculator-form";

    const preset = getFeePreset("paypal-us-checkout-paypal-payment");

    if (!preset) {
      throw new Error("The PayPal fee preset is missing from the registry.");
    }

    const form = requireHtmlForm("paypal-fee-form");

    const MODE_TEXT = {
      received: {
        amountLabel: "Amount the customer paid",
        amountHelp: "The full amount processed, including any sales tax you collected.",
        primaryLabel: "You keep from this sale",
      },
      net: {
        amountLabel: "Amount you want to keep",
        amountHelp: "What should reach you after PayPal's fee and any sales tax you collect.",
        primaryLabel: "Charge the customer",
      },
    } as const;

    type FeeMode = keyof typeof MODE_TEXT;

    let latestCopy: string | null = null;

    function currentMode(): FeeMode {
      const checked = form.querySelector('input[name="feeMode"]:checked');

      return checked instanceof HTMLInputElement && checked.value === "net" ? "net" : "received";
    }

    function setResult(id: string, text: string): void {
      requireHtmlElement(id).textContent = text;
    }

    function applyModeText(mode: FeeMode): void {
      const text = MODE_TEXT[mode];

      requireHtmlElement("amount-label").textContent = text.amountLabel;
      requireHtmlElement("amount-help").textContent = text.amountHelp;
      requireHtmlElement("primary-label").textContent = text.primaryLabel;
      requireHtmlElement("keep-row").hidden = mode !== "net";
    }

    function clear(): void {
      for (const id of ["fee-result", "fee-total-result", "net-result", "tax-result", "keep-result"]) {
        setResult(id, "—");
      }

      requireHtmlElement("tax-row").hidden = true;
      requireHtmlButton("copy-fee").disabled = true;
      latestCopy = null;
    }

    function parseTax(): bigint {
      const value = requireHtmlInput("taxIncluded").value.trim();

      return value.length === 0 ? 0n : usdToCents(value, "taxIncluded");
    }

    function calc(activePreset: FeePreset): void {
      const mode = currentMode();

      try {
        const amount = usdToCents(requireHtmlInput("amount").value, "amount");
        const tax = parseTax();

        if (tax > amount) {
          throw new InputProblem("taxIncluded", "Sales tax cannot be larger than the amount.");
        }

        const result =
          mode === "received"
            ? calculateFees({ preset: activePreset, grossCents: amount, taxCents: tax })
            : grossUpFees({ preset: activePreset, targetProceedsCents: amount, taxCents: tax });

        setResult(
          "fee-result",
          formatUsdGrouped(mode === "received" ? result.sellerProceedsCents : result.grossCents),
        );
        setResult("fee-total-result", formatUsdGrouped(result.feeCents));
        setResult("net-result", formatUsdGrouped(result.netAfterFeesCents));

        const taxRow = requireHtmlElement("tax-row");

        if (result.taxCents > 0n) {
          taxRow.hidden = false;
          setResult("tax-result", formatUsdGrouped(result.taxCents));
        } else {
          taxRow.hidden = true;
        }

        const reviewed = result.checkedOn ?? "date not recorded";

        if (mode === "net") {
          setResult("keep-result", formatUsdGrouped(result.sellerProceedsCents));
        }

        latestCopy =
          mode === "received"
            ? `PayPal Checkout (PayPal payment) on ${formatUsdGrouped(result.grossCents)}: ${formatUsdGrouped(result.feeCents)} fee, you keep ${formatUsdGrouped(result.sellerProceedsCents)} (estimate; source reviewed ${reviewed}).`
            : `To keep ${formatUsdGrouped(amount)} from a PayPal Checkout PayPal payment, charge ${formatUsdGrouped(result.grossCents)} (estimate; source reviewed ${reviewed}).`;

        requireHtmlButton("copy-fee").disabled = false;
        requireHtmlElement("fee-message").textContent = "";
        setFieldState(form);
      } catch (error) {
        clear();

        const problem =
          error instanceof InputProblem
            ? error
            : new InputProblem(
                "amount",
                mode === "received"
                  ? "Enter an amount above zero."
                  : "This target cannot be reached. Try a smaller amount.",
              );

        setFieldState(form, problem);
      }
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      calc(preset);
    });

    form.querySelectorAll('input[name="feeMode"]').forEach((element) => {
      element.addEventListener("change", () => {
        applyModeText(currentMode());
        calc(preset);
      });
    });

    for (const id of ["amount", "taxIncluded"]) {
      requireHtmlInput(id).addEventListener("input", () => calc(preset));
    }

    requireHtmlButton("paypal-fee-reset").addEventListener("click", () => {
      form.reset();
      applyModeText(currentMode());
      calc(preset);
    });

    requireHtmlButton("copy-fee").addEventListener("click", async () => {
      if (latestCopy === null) return;

      try {
        await navigator.clipboard.writeText(latestCopy);
        requireHtmlElement("fee-message").textContent = "Result copied.";
      } catch {
        requireHtmlElement("fee-message").textContent =
          "Copy was unavailable. Select the result to copy it manually.";
      }
    });

    applyModeText(currentMode());

    calc(preset);
  </script>
</Layout>
