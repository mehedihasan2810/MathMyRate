---
import { calculateFees, grossUpFees } from "@MathMyRate/calculators";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DataTable from "../../components/DataTable.astro";
import EmbedSnippet from "../../components/EmbedSnippet.astro";
import FaqSection from "../../components/FaqSection.astro";
import FeeCalculator from "../../components/FeeCalculator.astro";
import FeeRuleDetails from "../../components/FeeRuleDetails.astro";
import PageByline from "../../components/PageByline.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import { findFeeCalculator } from "../../data/fee-calculators";
import { findTool, toolBreadcrumbs } from "../../data/tools";
import Layout from "../../layouts/Layout.astro";
import { formatCombinedRate } from "../../lib/fee-labels";
import { commonSaleAmounts, feeRowsByAmount, requireOfficialPreset, scenarioRowsAt } from "../../lib/fee-tables";
import type { FaqEntry } from "../../lib/structured-data";
import { formatUsdGrouped } from "../../scripts/calculator-form";

const tool = findTool("lemon-squeezy-fees");

const breadcrumbs = toolBreadcrumbs(tool.id);

const config = findFeeCalculator("lemon-squeezy");

const domestic = requireOfficialPreset("lemon-squeezy-us-domestic-card");

const international = requireOfficialPreset("lemon-squeezy-us-international-card");

const rate = formatCombinedRate(domestic.components);

const sale = calculateFees({ preset: domestic, grossCents: 10000n });

const target = grossUpFees({ preset: domestic, targetProceedsCents: 10000n });

const workedExample = calculateFees({ preset: international, grossCents: 2400n, taxCents: 400n });

const amountRows = feeRowsByAmount(domestic, commonSaleAmounts);

const scenarioRows = scenarioRowsAt(config.scenarios, 10000n);

const updatedOn = "2026-09-15";

const title = `${tool.name} (${rate}) | MathMyRate`;

const description = `Estimate Lemon Squeezy's ${rate} fee on the order total, plus international, PayPal, and subscription fees, what you keep, and what to charge.`;

const guideSources = [
  { title: "Docs: Fees • Lemon Squeezy", url: "https://docs.lemonsqueezy.com/help/getting-started/fees" },
  { title: "Docs: Sales Tax and VAT • Lemon Squeezy", url: "https://docs.lemonsqueezy.com/help/payments/sales-tax-vat" },
  { title: "Docs: Getting Paid • Lemon Squeezy", url: "https://docs.lemonsqueezy.com/help/getting-started/getting-paid" },
  { title: "Docs: Refunds and Chargebacks • Lemon Squeezy", url: "https://docs.lemonsqueezy.com/help/payments/refunds-chargebacks" },
  { title: "Lemon Squeezy pricing", url: "https://www.lemonsqueezy.com/pricing" },
];

const faq: readonly FaqEntry[] = [
  { question: "What are Lemon Squeezy's fees?", answer: `Lemon Squeezy charges ${rate} per transaction, calculated on the total order value. Its fee page adds 1.5% for buyers outside the US, 1.5% for PayPal transactions, and 0.5% for subscription payments. A $100 US card order with no tax pays ${formatUsdGrouped(sale.feeCents)}.` },
  { question: "Is the Lemon Squeezy fee charged on tax?", answer: `Yes. The platform fee is calculated on the total order value, which includes the tax Lemon Squeezy adds. In its own example, a $20.00 product with $4.00 of VAT and an international card pays $0.50 plus 6.5% of $24.00, or ${formatUsdGrouped(workedExample.feeCents)}.` },
  { question: "Do Lemon Squeezy's additional fees combine?", answer: "The fee page lists the international, PayPal, and subscription fees separately and does not say whether they combine on one order, for example an international PayPal subscription. This calculator supports each one on its own and does not guess combinations." },
  { question: "Does Lemon Squeezy return its fee when I refund an order?", answer: "No. When you refund an order, the refunded amount minus Lemon Squeezy's platform fee is deducted from your next payout, so the fee stays with Lemon Squeezy." },
  { question: "What happens when a customer files a chargeback?", answer: "Lemon Squeezy usually refunds the customer on your behalf and deducts the refunded amount, minus its platform fee, plus a $15 dispute fee from your next payout." },
  { question: "How much does a Lemon Squeezy payout cost?", answer: "Payouts through Stripe are free for bank accounts in the US and 1% for bank accounts outside the US. PayPal payouts cost a flat $0.50 in the US and 3%, capped at $30, outside the US." },
  { question: "When does Lemon Squeezy pay out?", answer: "Payouts are created on the 1st and 15th of each month. Net sales are held for 13 days and paid on the 14th and 28th, and payouts need at least $50. Smaller balances roll over to the next payout." },
  { question: "Do I need to handle sales tax myself?", answer: "Lemon Squeezy is the merchant of record, so it collects and remits sales tax and VAT on your sales and deducts that tax from your payout. You may still owe income tax on the payouts you receive." },
  { question: "How do I charge enough to cover Lemon Squeezy's fee?", answer: `Choose I want to keep a target and enter the amount you want to receive. To keep $100.00 from a US card order with no tax, charge ${formatUsdGrouped(target.grossCents)}.` },
];
---
<Layout title={title} description={description} ogImage="/og/lemon-squeezy.png" breadcrumbs={breadcrumbs} applicationName={tool.name}>
  <main id="main-content" class="mx-auto max-w-6xl px-5 py-8 md:px-8 md:py-10">
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="display mt-3 text-3xl font-bold md:text-4xl">{tool.name}</h1>
    <p class="mt-2 max-w-2xl leading-relaxed text-ink/70">Lemon Squeezy's fee, down to the cent, for US and international card orders, PayPal orders, and subscription payments, with tax included.</p>
    <PageByline updatedOn={updatedOn} reviewedOn={domestic.checkedOn} />
    <FeeCalculator calculatorId="lemon-squeezy" />
    <article class="guide mt-14 border-t border-line pt-4">
      <h2>What this calculator tells you</h2>
      <p>The Lemon Squeezy fee calculator shows what Lemon Squeezy keeps from an order and what reaches you. It charges <strong>{rate}</strong> per transaction on the total order value, so a $100 US card order with no tax pays <strong>{formatUsdGrouped(sale.feeCents)}</strong> and leaves <strong>{formatUsdGrouped(sale.sellerProceedsCents)}</strong>. International buyers, PayPal, and subscriptions each add a percentage, and any tax on the order is part of the amount the fee is calculated on.</p>

      <h2>How to use it</h2>
      <ol>
        <li>Choose the kind of order: a US card order, an international card order, a PayPal order, or a subscription payment.</li>
        <li>Choose whether you know the order total, or what you want to keep.</li>
        <li>Enter the amount. If Lemon Squeezy added tax, use the total including tax and enter the tax separately.</li>
        <li>To see monthly and yearly totals, enter how many same-size orders you make a month.</li>
      </ol>

      <h2>How the fee is built</h2>
      <p>Lemon Squeezy's fee page works through an example, and the calculator reproduces it exactly: a buyer in France buys a $20.00 product by card, and 20% VAT adds $4.00.</p>
      <ol>
        <li><strong>Total order value.</strong> $20.00 plus $4.00 of VAT is $24.00.</li>
        <li><strong>Platform fee.</strong> 5% of $24.00 is $1.20, and the international fee of 1.5% is $0.36. Adding the fixed $0.50 gives {formatUsdGrouped(workedExample.feeCents)}.</li>
        <li><strong>What you keep.</strong> $24.00 minus $4.00 of tax minus the fee is {formatUsdGrouped(workedExample.sellerProceedsCents)}.</li>
      </ol>

      <h2>Lemon Squeezy fees at common order amounts</h2>
      <p>US card orders with no tax collected. The fixed 50¢ weighs more on small orders.</p>
      <DataTable caption={`Lemon Squeezy fee (${rate}) by order total`} headers={["Order total", "Lemon Squeezy fee", "You keep", "Fee share"]} rows={amountRows} />

      <h2>The same $100 order in every scenario</h2>
      <DataTable caption="Lemon Squeezy fee on a $100 order by order type, with no tax" headers={["Scenario", "Rate", "Lemon Squeezy fee", "You keep"]} rows={scenarioRows} />

      <h2>Tax, refunds, payouts, and marketing fees</h2>
      <ul>
        <li><strong>Merchant of record:</strong> Lemon Squeezy collects and remits sales tax and VAT. Tax is added on top of your price unless you turn on tax-inclusive pricing, which applies to every product in the store.</li>
        <li><strong>Refunds:</strong> the refunded amount minus the platform fee comes out of your next payout, so the fee is not returned.</li>
        <li><strong>Chargebacks:</strong> the refunded amount minus the platform fee, plus a $15 dispute fee, comes out of your next payout.</li>
        <li><strong>Payouts:</strong> through Stripe, free for US bank accounts and 1% outside the US. Through PayPal, $0.50 in the US and 3% capped at $30 outside the US. Payouts are paid on the 14th and 28th, with a $50 minimum. The <a href="/fees/payout-fee-calculator/">payout fee calculator</a> prices US payouts.</li>
        <li><strong>Marketing features:</strong> 5% of payments recovered through abandoned cart emails, and 3% of each order referred by an affiliate.</li>
        <li><strong>Custom pricing:</strong> Lemon Squeezy offers it to large or fast-growing businesses, high-volume businesses, and stores selling products under $10.</li>
      </ul>

      <FeeRuleDetails calculatorId="lemon-squeezy" blockedPresetIds={["lemon-squeezy-payout"]} />

      <FaqSection entries={faq} />

      <EmbedSnippet toolId="lemon-squeezy-fees" />

      <h2>Sources</h2>
      <ul class="text-base">{guideSources.map((source) => <li><a href={source.url} rel="noopener">{source.title}</a></li>)}</ul>
      <p class="text-sm text-ink/60">Lemon Squeezy's pages were reviewed on the date shown at the top of this page. Store-specific plans can differ. MathMyRate is not affiliated with Lemon Squeezy. See <a href="/methodology/">how the numbers are made</a> and the <a href="/changelog/">changelog</a>.</p>
    </article>
    <RelatedTools current={tool.id} />
  </main>
</Layout>
