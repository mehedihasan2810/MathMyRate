---
import Layout from "../layouts/Layout.astro";

const tools = [
  {
    href: "/freelance/hourly-rate-calculator/",
    category: "Freelance pricing",
    title: "Freelance hourly & day rate calculator",
    description: "Turn an annual take-home target into a practical floor hourly and day rate.",
    keywords: "hourly day rate capacity billable tax reserve take-home salary income freelance",
  },
  {
    href: "/freelance/project-rate-calculator/",
    category: "Freelance pricing",
    title: "Project rate calculator",
    description: "Build a fixed-price quote from scope, contingency, and reimbursable costs.",
    keywords: "project quote fixed price flat fee scope estimate freelance",
  },
  {
    href: "/fees/stripe-fee-calculator/",
    category: "Payment fees",
    title: "Stripe fee calculator",
    description: "See the card-processing fee and what a sale really pays you.",
    keywords: "stripe card processing fee gross up net sale checkout",
  },
  {
    href: "/fees/paypal-fee-calculator/",
    category: "Payment fees",
    title: "PayPal fee calculator",
    description: "See PayPal's checkout fee and what a sale really pays you.",
    keywords: "paypal wallet checkout fee net sale",
  },
  {
    href: "/fees/gumroad-fee-calculator/",
    category: "Payment fees",
    title: "Gumroad fee calculator",
    description: "Compare direct sales with Discover marketplace sales, fees side by side.",
    keywords: "gumroad marketplace digital products fee sale",
  },
  {
    href: "/fees/lemon-squeezy-fee-calculator/",
    category: "Payment fees",
    title: "Lemon Squeezy fee calculator",
    description: "Order fees for domestic card sales, with payout costs kept separate.",
    keywords: "lemon squeezy digital products order fee merchant of record",
  },
];
---

<Layout
  title="MathMyRate | Price your independent work"
  description="Every MathMyRate calculator on one page: freelance rates and payment fees. Search, pick a tool, and get clear numbers."
  ogImage="/og/home.png"
>
  <main id="main-content" class="mx-auto max-w-6xl px-5 pb-20 pt-10 md:px-8 md:pt-12">
    <h1 class="eyebrow page-enter">All calculators, one page</h1>

    <section class="mt-8">
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
        <div class="w-full max-w-2xl">
          <label for="tool-search" class="block text-sm font-semibold text-ink">Search tools</label>
          <input
            id="tool-search"
            type="search"
            placeholder='Try "stripe" or "hourly rate"'
            autocomplete="off"
            spellcheck="false"
            class="mt-2 w-full rounded-lg border border-line bg-white px-4 py-3 text-base text-ink placeholder:text-ink/40"
          />
        </div>
        <p id="tool-count" role="status" class="text-sm text-ink/60">Showing all {tools.length} tools</p>
      </div>

      <ul id="tool-grid" class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((tool) => (
          <li
            data-tool
            data-search={`${tool.title} ${tool.category} ${tool.description} ${tool.keywords}`.toLowerCase()}
            class="rounded-2xl border border-line bg-white shadow-sm transition-colors hover:border-ink/30"
          >
            <article class="flex h-full flex-col p-6">
              <p class="eyebrow">{tool.category}</p>
              <h3 class="display mt-3 text-xl font-bold">{tool.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/65">{tool.description}</p>
              <a
                href={tool.href}
                class="mt-6 inline-flex items-center justify-center gap-2 rounded-lg bg-navy px-5 py-2.5 font-semibold text-paper transition-colors hover:bg-ink"
              >
                Open calculator <span aria-hidden="true">→</span>
              </a>
            </article>
          </li>
        ))}
      </ul>

      <div id="no-results" hidden class="mt-6 rounded-2xl border border-dashed border-line bg-white p-10 text-center">
        <p class="font-semibold text-ink">No tools match your search.</p>
        <p class="mt-2 text-sm text-ink/65">Try a shorter word, or clear the search to see every calculator.</p>
        <button
          type="button"
          id="clear-search"
          class="mt-5 rounded-lg border border-ink/25 px-5 py-2.5 font-semibold text-ink transition-colors hover:bg-mist"
        >
          Clear search
        </button>
      </div>
    </section>

    <p class="mt-14 border-t border-line pt-6 text-sm leading-relaxed text-ink/60">
      Every result names its assumptions, and nothing leaves your browser.
      <a class="font-semibold underline transition-colors hover:text-navy" href="/methodology/">How the numbers are made</a>.
    </p>
  </main>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>("#tool-search");

    const grid = document.querySelector<HTMLUListElement>("#tool-grid");

    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-tool]"));

    const noResults = document.querySelector<HTMLElement>("#no-results");

    const clearButton = document.querySelector<HTMLButtonElement>("#clear-search");

    const count = document.querySelector<HTMLElement>("#tool-count");

    if (searchInput && grid && noResults && clearButton && count) {
      const applyFilter = () => {
        const query = searchInput.value.trim().toLowerCase();
        let visible = 0;

        for (const card of cards) {
          const haystack = card.dataset.search ?? "";
          const matches = query === "" || haystack.includes(query);
          card.hidden = !matches;

          if (matches) visible += 1;
        }

        grid.hidden = visible === 0;
        noResults.hidden = visible > 0;
        count.textContent =
          query === "" ? `Showing all ${cards.length} tools` : `Showing ${visible} of ${cards.length} tools`;
      };

      searchInput.addEventListener("input", applyFilter);

      clearButton.addEventListener("click", () => {
        searchInput.value = "";
        searchInput.focus();
        applyFilter();
      });
    }
  </script>
</Layout>
