---
import ContractorRateCalculator from "../../components/ContractorRateCalculator.astro";
import EarlyPaymentDiscountCalculator from "../../components/EarlyPaymentDiscountCalculator.astro";
import FeeCalculator from "../../components/FeeCalculator.astro";
import HourlyRateCalculator from "../../components/HourlyRateCalculator.astro";
import KdpRoyaltyCalculator from "../../components/KdpRoyaltyCalculator.astro";
import MarkupMarginCalculator from "../../components/MarkupMarginCalculator.astro";
import PayoutFeeCalculator from "../../components/PayoutFeeCalculator.astro";
import ProjectRateCalculator from "../../components/ProjectRateCalculator.astro";
import RateIncreaseCalculator from "../../components/RateIncreaseCalculator.astro";
import RetainerCalculator from "../../components/RetainerCalculator.astro";
import SalaryToHourlyCalculator from "../../components/SalaryToHourlyCalculator.astro";
import ServiceFeeCalculator from "../../components/ServiceFeeCalculator.astro";
import { embeddableTools, type EmbeddableTool } from "../../data/embeds";
import { findTool } from "../../data/tools";
import EmbedLayout from "../../layouts/EmbedLayout.astro";
import { embedPath } from "../../lib/embed";

export function getStaticPaths() {
  return embeddableTools.map((embed) => ({
    params: { calculator: embedPath(findTool(embed.toolId)).split("/").filter(Boolean).at(-1) ?? embed.toolId },
    props: { embed },
  }));
}

interface Props {
  embed: EmbeddableTool;
}

const { embed } = Astro.props;

const tool = findTool(embed.toolId);
---
<EmbedLayout title={`${tool.name} | MathMyRate`} toolHref={tool.href} toolName={tool.name}>
  {embed.kind === "fee" ? <FeeCalculator calculatorId={embed.calculatorId} stickyResult={false} /> : null}
  {embed.toolId === "hourly-rate" ? <HourlyRateCalculator embedded /> : null}
  {embed.toolId === "project-rate" ? <ProjectRateCalculator embedded /> : null}
  {embed.toolId === "retainer" ? <RetainerCalculator embedded /> : null}
  {embed.toolId === "markup-margin" ? <MarkupMarginCalculator embedded /> : null}
  {embed.toolId === "salary-to-hourly" ? <SalaryToHourlyCalculator embedded /> : null}
  {embed.toolId === "upwork-fees" ? <ServiceFeeCalculator calculatorId="upwork" embedded /> : null}
  {embed.toolId === "fiverr-fees" ? <ServiceFeeCalculator calculatorId="fiverr" embedded /> : null}
  {embed.toolId === "kdp-royalties" ? <KdpRoyaltyCalculator embedded /> : null}
  {embed.toolId === "early-payment-discount" ? <EarlyPaymentDiscountCalculator embedded /> : null}
  {embed.toolId === "rate-increase" ? <RateIncreaseCalculator embedded /> : null}
  {embed.toolId === "contractor-rate" ? <ContractorRateCalculator embedded /> : null}
  {embed.toolId === "payout-fees" ? <PayoutFeeCalculator embedded /> : null}
</EmbedLayout>
