---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { guides, guidesIndex } from "../../data/guides";
import { findTool, hubBreadcrumbs } from "../../data/tools";
import Layout from "../../layouts/Layout.astro";
import { formatReadableDate } from "../../lib/dates";

const [home] = hubBreadcrumbs("freelance");

if (!home) throw new Error("The breadcrumb trail has no home link.");

const breadcrumbs = [home, guidesIndex];
---
<Layout title="Freelance Pricing and Payment Fee Guides | MathMyRate" description="Short, worked guides on markup and margin, comparing a salary with a freelance rate, and pricing to cover payment fees, each linked to a free calculator." ogImage="/og/guides.png" breadcrumbs={breadcrumbs}>
  <main id="main-content" class="mx-auto max-w-6xl px-5 py-10 md:px-8 md:py-16">
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="display mt-4 max-w-3xl text-4xl font-bold leading-tight md:text-5xl">Pricing and Payment Fee Guides</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/70">Each guide answers one pricing question with worked numbers, then hands you to the calculator that finishes the job. Every figure comes from the same code the calculators use.</p>
    <ul class="mt-12 grid gap-4 md:grid-cols-2">
      {guides.map((guide) => (
        <li>
          <a href={guide.href} class="block h-full rounded-[1.5rem] border border-line bg-[#fafbfd] p-8 transition-transform hover:-translate-y-1">
            <p class="eyebrow">Updated <time datetime={guide.updatedOn}>{formatReadableDate(guide.updatedOn)}</time></p>
            <h2 class="display mt-4 text-2xl font-bold">{guide.title}</h2>
            <p class="mt-3 text-ink/65">{guide.summary}</p>
            <p class="mt-6 text-sm text-ink/60">Uses: {guide.tools.map((id) => findTool(id).name).join(", ")}</p>
            <span class="mt-4 block font-semibold text-navy">Read the guide →</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>
