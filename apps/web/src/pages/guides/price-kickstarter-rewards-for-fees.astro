---
import { analyzePrice, calculateFees, grossUpFees, repeatSale } from "@MathMyRate/calculators";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DataTable from "../../components/DataTable.astro";
import GuideTools from "../../components/GuideTools.astro";
import PageByline from "../../components/PageByline.astro";
import { findGuide, guideBreadcrumbs } from "../../data/guides";
import Layout from "../../layouts/Layout.astro";
import { formatSaleLabel, requireOfficialPreset } from "../../lib/fee-tables";
import { formatPercentBps, formatUsdGrouped } from "../../scripts/calculator-form";

const guide = findGuide("kickstarter-reward-pricing");

const breadcrumbs = guideBreadcrumbs(guide.id);

const standard = requireOfficialPreset("kickstarter-us-pledge");

const micro = requireOfficialPreset("kickstarter-us-micropledge");

function pledge(grossCents: bigint) {
  return calculateFees({ preset: grossCents < 1_000n ? micro : standard, grossCents });
}

const fifty = pledge(5_000n);

const one = pledge(100n);

const rewardCostCents = 1_500n;

const shippingCents = 800n;

const rewardProfit = fifty.sellerProceedsCents - rewardCostCents - shippingCents;

const rewardMargin = analyzePrice({ costCents: rewardCostCents + shippingCents + fifty.feeCents, priceCents: 5_000n });

const targetRows = [1_500n, 2_500n, 4_000n, 7_500n, 15_000n].map((targetCents) => {
  const quote = grossUpFees({ preset: standard, targetProceedsCents: targetCents });

  return [formatUsdGrouped(targetCents), formatUsdGrouped(quote.grossCents), formatUsdGrouped(quote.feeCents)];
});

const goalCents = 1_000_000n;

const backersNeeded = Number((goalCents + fifty.sellerProceedsCents - 1n) / fifty.sellerProceedsCents);

const goalCampaign = repeatSale(fifty, backersNeeded);

const pledgeRows = [100n, 500n, 1_000n, 2_500n, 5_000n, 10_000n].map((grossCents) => {
  const result = pledge(grossCents);

  return [formatSaleLabel(grossCents), formatUsdGrouped(result.feeCents), formatUsdGrouped(result.sellerProceedsCents), formatPercentBps((result.feeCents * 10_000n + result.grossCents / 2n) / result.grossCents)];
});
---
<Layout title="Price Kickstarter Rewards to Cover Fees | MathMyRate" description={guide.description} ogImage="/og/kickstarter-reward-pricing.png" breadcrumbs={breadcrumbs} article={{ headline: guide.title, publishedOn: guide.publishedOn, updatedOn: guide.updatedOn }}>
  <main id="main-content" class="mx-auto max-w-6xl px-5 py-8 md:px-8 md:py-10">
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="display mt-3 max-w-3xl text-3xl font-bold md:text-4xl">{guide.title}</h1>
    <p class="mt-2 max-w-2xl leading-relaxed text-ink/70">A reward priced at its cost loses money once Kickstarter's fees come out. Here is how to price for what each pledge really leaves you.</p>
    <PageByline updatedOn={guide.updatedOn} reviewedOn={standard.checkedOn} />
    <article class="guide mt-8">
      <h2>What a pledge leaves you</h2>
      <p>On a successfully funded US project, Kickstarter keeps 5% of each collected pledge, and payment processing takes 3% + $0.30, or 5% + $0.08 for pledges under $10. A $50 pledge leaves <strong>{formatUsdGrouped(fifty.sellerProceedsCents)}</strong>; a $1 pledge leaves {formatUsdGrouped(one.sellerProceedsCents)}.</p>
      <DataTable caption="Kickstarter fees on one collected pledge" headers={["Pledge", "Fees", "You receive", "Fee share"]} rows={pledgeRows} />

      <h2>Price the reward on what is left</h2>
      <p>Say a $50 reward costs $15.00 to make and $8.00 to ship. After fees you receive {formatUsdGrouped(fifty.sellerProceedsCents)}, so the reward earns <strong>{formatUsdGrouped(rewardProfit)}</strong>, a {formatPercentBps(rewardMargin.marginBps ?? 0n)} margin on the pledge once fees count as a cost. Leave the fees out and the same reward looks like it earns $27.00.</p>
      <p>The <a href="/freelance/markup-margin-calculator/">markup and margin calculator</a> shows the margin for any cost and price: add the fees to the cost to see the real figure.</p>

      <h2>What to charge to keep a set amount</h2>
      <p>To keep a target after fees, divide the target plus $0.30 by 0.92, then round up to the cent. These pledges leave at least the amount in the first column.</p>
      <DataTable caption="Pledge needed to keep each amount after Kickstarter's fees" headers={["To keep", "Charge", "Fees"]} rows={targetRows} />

      <h2>How many backers it takes to net your goal</h2>
      <p>Kickstarter shows the total pledged, but fees come out before your payout. If every backer pledges $50, netting $10,000 takes <strong>{backersNeeded} backers</strong>, who pledge {formatUsdGrouped(goalCampaign.grossCents)} and leave you {formatUsdGrouped(goalCampaign.sellerProceedsCents)}. Rewards, shipping, and taxes still come out of that.</p>
      <p>Fees apply only to pledges Kickstarter collects. A pledge dropped after failed payments pays no fee, but it also brings in no money, so a goal set exactly at your costs can fall short after the campaign ends.</p>

      <h2>Late pledges, Pledge Over Time, and the Pledge Manager</h2>
      <ul>
        <li><strong>Late Pledges</strong> pay the same fees as campaign pledges.</li>
        <li><strong>Pledge Over Time</strong> adds no extra fee, but the fees apply to each charge.</li>
        <li><strong>Pledge Manager</strong> payments pay 5% on the amount before taxes, plus processing that Kickstarter describes only as roughly 3-5%, so they are not priced here.</li>
      </ul>
      <p>The <a href="/fees/kickstarter-fee-calculator/">Kickstarter fee calculator</a> works out any pledge and totals a campaign.</p>

      <h2>Sources</h2>
      <ul class="text-base">
        <li><a href="https://www.kickstarter.com/help/fees" rel="noopener">Fees: United States — Kickstarter</a></li>
        <li><a href="https://help.kickstarter.com/en-us/articles/16236674-what-are-the-fees" rel="noopener">What are the fees? | Kickstarter Help Center</a></li>
        <li><a href="https://help.kickstarter.com/en-us/articles/16236454-what-happens-when-there-is-a-problem-with-one-of-my-backer-s-pledges" rel="noopener">What happens when there is a problem with one of my backer's pledges? | Kickstarter Help Center</a></li>
        <li><a href="https://help.kickstarter.com/en-us/articles/16236699-how-do-i-add-late-pledges-to-my-project" rel="noopener">How do I add Late Pledges to my project? | Kickstarter Help Center</a></li>
        <li><a href="https://help.kickstarter.com/en-us/articles/16236386-pledge-over-time-faq" rel="noopener">Pledge Over Time FAQ | Kickstarter Help Center</a></li>
      </ul>
      <p class="text-sm text-ink/60">Kickstarter's pages were reviewed on the date shown above. MathMyRate is not affiliated with Kickstarter.</p>
    </article>
    <GuideTools guide={guide.id} />
  </main>
</Layout>
