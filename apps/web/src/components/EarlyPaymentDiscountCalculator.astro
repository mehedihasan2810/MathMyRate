---
import { calculateEarlyPaymentDiscount } from "@MathMyRate/calculators";
import { formatPercentBps, formatUsdGrouped } from "../scripts/calculator-form";
import NumberField from "./NumberField.astro";
import ResultRow from "./ResultRow.astro";
import StickyResult from "./StickyResult.astro";

interface Props {
  /** Embedded copies leave out the pinned result bar. */
  embedded?: boolean;
}

const { embedded = false } = Astro.props;

const rowLabel = "text-[#f3f5fa]/80";

const example = calculateEarlyPaymentDiscount({ invoiceCents: 100_000n, discountBps: 200, discountDays: 10, netDays: 30 });
---

<div class="mt-8 grid gap-8 lg:grid-cols-[1fr_.85fr]">
  <form id="discount-form" data-calculator-form class="print-card rounded-[1.5rem] border border-line bg-[#fafbfd] p-6 shadow-[0_16px_45px_rgba(19,31,51,.08)] md:p-8" novalidate>
    <div class="flex items-baseline justify-between gap-3"><h2 class="display text-2xl font-bold">Invoice and terms</h2><span class="shrink-0 text-xs text-ink/50">USD</span></div>
    <div data-error-summary role="alert" hidden class="mt-5 rounded-lg border border-[#d99c89] bg-[#fff0e9] p-3 text-sm text-[#8f3c2d]"></div>
    <div class="mt-7 grid gap-5 sm:grid-cols-2">
      <NumberField id="invoiceAmount" label="Invoice amount" value="1,000.00" unit="usd" required help="The amount the discount applies to." />
      <NumberField id="discountPercent" label="Early payment discount" value="2" unit="percent" required help="The 2 in 2/10 net 30." />
      <NumberField id="discountDays" label="Discount period (days)" value="10" inputMode="numeric" required help="The 10 in 2/10 net 30." />
      <NumberField id="netDays" label="Net due date (days)" value="30" inputMode="numeric" required help="The 30 in 2/10 net 30." />
    </div>
    <div class="calculator-actions mt-7 flex flex-wrap gap-3"><button class="rounded-full bg-ink px-5 py-2.5 text-sm font-bold text-paper" type="button" id="discount-update">Update terms</button><button id="discount-reset" class="rounded-full border border-line px-5 py-2.5 text-sm font-semibold" type="button">Reset example</button></div>
  </form>
  <aside id="discount-panel" data-result-panel aria-live="polite" class="print-card h-fit rounded-[1.5rem] bg-[#2b3c5e] p-7 text-[#f3f5fa] shadow-[0_16px_45px_rgba(19,31,51,.18)] md:p-9">
    <p class="eyebrow !text-[#f2e3bd]" data-primary-label>Paid early, the client pays</p><p id="discount-total-result" data-primary-result class="result-value display mt-4 text-6xl font-bold">{formatUsdGrouped(example.discountedTotalCents)}</p><p id="discount-note" class="mt-1 text-[#f3f5fa]/80">within 10 days, instead of {formatUsdGrouped(example.invoiceCents)} by day 30</p>
    <div class="my-7 border-t border-[#f3f5fa]/30"></div>
    <div class="[&>:first-child]:mt-0">
      <ResultRow label="Discount" valueId="discount-result" value={formatUsdGrouped(example.discountCents)} labelClass={rowLabel} />
      <ResultRow label="Paid by the due date" valueId="full-result" value={formatUsdGrouped(example.invoiceCents)} labelClass={rowLabel} />
      <ResultRow label="Days earlier" valueId="days-result" value={String(example.daysEarlier)} labelClass={rowLabel} />
      <ResultRow label="Annualized cost of the discount" valueId="rate-result" value={formatPercentBps(example.annualizedCostBps)} labelClass={rowLabel} />
    </div>
    <div class="calculator-actions mt-8 flex flex-wrap gap-2"><button id="copy-discount" type="button" class="rounded-full bg-[#f3f5fa] px-4 py-2.5 text-sm font-bold text-ink">Copy result</button><button type="button" data-print class="rounded-full border border-[#f3f5fa]/45 px-4 py-2.5 text-sm font-bold">Print</button></div><p id="discount-message" class="mt-4 text-sm text-[#f2e3bd]" aria-live="polite"></p>
  </aside>
</div>
{embedded ? null : <StickyResult />}
<noscript><p class="mt-5 rounded-lg border border-line bg-mist p-4 text-sm">JavaScript is required to update this calculator. The example shows a $1,000.00 invoice on 2/10 net 30 terms.</p></noscript>

<script>
  import { calculateEarlyPaymentDiscount, type EarlyPaymentResult } from "@MathMyRate/calculators";
  import {
    type CalculationTrigger,
    focusProblemField,
    formatPercentBps,
    formatUsdGrouped,
    InputProblem,
    markResultsCurrent,
    markResultsStale,
    percentToBps,
    requireHtmlButton,
    requireHtmlElement,
    requireHtmlForm,
    requireHtmlInput,
    setFieldState,
    shouldDeferProblem,
    usdToCents,
    watchCalculatorFields,
    wholeNumber,
  } from "../scripts/calculator-form";

  interface Terms {
    readonly discountBps: number;
    readonly discountDays: number;
    readonly netDays: number;
  }

  const form = requireHtmlForm("discount-form");

  const panel = requireHtmlElement("discount-panel");

  const copyButton = requireHtmlButton("copy-discount");

  let latest: { readonly terms: Terms; readonly result: EarlyPaymentResult } | null = null;

  function setText(id: string, text: string): void {
    requireHtmlElement(id).textContent = text;
  }

  /** When the discount applies: "within 10 days", or "on the invoice date" for a 0-day period. */
  function discountWindow(days: number): string {
    if (days === 0) return "on the invoice date";

    return days === 1 ? "within 1 day" : `within ${days.toLocaleString("en-US")} days`;
  }

  function readTerms(): Terms {
    const discountBps = percentToBps(requireHtmlInput("discountPercent").value, "discountPercent", 9_999);

    if (discountBps === 0) throw new InputProblem("discountPercent", "Enter a discount above 0%.");

    const discountDays = wholeNumber(requireHtmlInput("discountDays").value, "discountDays", 0, 364);
    const netDays = wholeNumber(requireHtmlInput("netDays").value, "netDays", 1, 365);

    if (discountDays >= netDays) {
      throw new InputProblem("discountDays", "The discount period must end before the net due date.");
    }

    return { discountBps, discountDays, netDays };
  }

  function clear(): void {
    for (const id of ["discount-total-result", "discount-result", "full-result", "days-result", "rate-result"]) {
      setText(id, "—");
    }

    setText("discount-note", "");
    latest = null;
    markResultsCurrent(panel, []);
    copyButton.disabled = true;
  }

  function calculate(trigger: CalculationTrigger): void {
    try {
      const invoiceCents = usdToCents(requireHtmlInput("invoiceAmount").value, "invoiceAmount");

      if (invoiceCents === 0n) throw new InputProblem("invoiceAmount", "Enter an amount above zero.");

      const terms = readTerms();
      const result = calculateEarlyPaymentDiscount({ invoiceCents, ...terms });

      setText("discount-total-result", formatUsdGrouped(result.discountedTotalCents));
      setText("discount-note", `${discountWindow(terms.discountDays)}, instead of ${formatUsdGrouped(result.invoiceCents)} by day ${terms.netDays.toLocaleString("en-US")}`);
      setText("discount-result", formatUsdGrouped(result.discountCents));
      setText("full-result", formatUsdGrouped(result.invoiceCents));
      setText("days-result", result.daysEarlier.toLocaleString("en-US"));
      setText("rate-result", formatPercentBps(result.annualizedCostBps));
      latest = { terms, result };
      markResultsCurrent(panel, [copyButton]);
      setText("discount-message", result.discountCents === 0n ? "The discount rounds to $0.00 on this amount." : "");
      setFieldState(form);
    } catch (error) {
      const problem = error instanceof InputProblem ? error : new InputProblem("invoiceAmount", "Check your inputs.");

      if (shouldDeferProblem(form, trigger)) {
        markResultsStale(panel, [copyButton]);

        return;
      }

      clear();
      setFieldState(form, problem);

      if (trigger === "submit") focusProblemField(form, problem);
      setText("discount-message", "");
    }
  }

  function copyText(terms: Terms, result: EarlyPaymentResult): string {
    const percent = formatPercentBps(BigInt(terms.discountBps));

    return `${percent} off ${discountWindow(terms.discountDays)}, net ${terms.netDays}, on ${formatUsdGrouped(result.invoiceCents)}: pay ${formatUsdGrouped(result.discountedTotalCents)} early (a ${formatUsdGrouped(result.discountCents)} discount) or ${formatUsdGrouped(result.invoiceCents)} by day ${terms.netDays}. Annualized cost of the discount: ${formatPercentBps(result.annualizedCostBps)}.`;
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    calculate("submit");
  });

  requireHtmlButton("discount-update").addEventListener("click", () => calculate("submit"));

  watchCalculatorFields(form, calculate);

  requireHtmlButton("discount-reset").addEventListener("click", () => {
    form.reset();
    calculate("commit");
  });

  copyButton.addEventListener("click", async () => {
    if (latest === null) return;

    try {
      await navigator.clipboard.writeText(copyText(latest.terms, latest.result));
      setText("discount-message", "Result copied.");
    } catch {
      setText("discount-message", "Copy was unavailable. Select the result to copy it manually.");
    }
  });

  calculate("commit");
</script>
