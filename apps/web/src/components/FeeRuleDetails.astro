---
import { getFeePreset, type FeePreset } from "@MathMyRate/calculators";
import { findFeeCalculator, scenarioPresetIds, type FeeCalculatorId } from "../data/fee-calculators";
import { formatCombinedRate } from "../lib/fee-labels";

interface Props {
  calculatorId: FeeCalculatorId;
  /** Documented cases the calculator refuses, each backed by a blocked preset. */
  blockedPresetIds?: readonly string[];
}

function requirePreset(id: string): FeePreset {
  const preset = getFeePreset(id);

  if (!preset) throw new Error(`The ${id} fee preset is missing from the registry.`);

  return preset;
}

const { calculatorId, blockedPresetIds = [] } = Astro.props;

const config = findFeeCalculator(calculatorId);

// A scenario with price bands lists each band as its own rule.
const scenarios = config.scenarios.flatMap((scenario) => {
  const presets = scenarioPresetIds(scenario).map(requirePreset);

  return presets.map((preset) => ({ heading: presets.length > 1 ? preset.label : scenario.label, preset }));
});

const blocked = blockedPresetIds.map(requirePreset);

const sources = new Map<string, string>();

for (const { preset } of scenarios) {
  for (const source of preset.sources) sources.set(source.url, source.title);
}
---

<section aria-labelledby="fee-rules-heading">
  <h2 id="fee-rules-heading">Every supported scenario, with its assumptions</h2>
  <p>Each scenario below is one official rule. The rate is the total of its published components, applied to the amount charged.</p>
  {scenarios.map(({ heading, preset }) => (
    <div>
      <h3>{heading}: {formatCombinedRate(preset.components)}</h3>
      <p class="text-base"><strong>Assumptions.</strong></p>
      <ul class="text-base">{preset.assumptions.map((assumption) => <li>{assumption}</li>)}</ul>
      <p class="text-base"><strong>Not covered.</strong></p>
      <ul class="text-base">{preset.exclusions.map((exclusion) => <li>{exclusion}</li>)}</ul>
    </div>
  ))}
  {blocked.length > 0 ? (
    <div>
      <h3>Cases this calculator refuses to guess</h3>
      <ul class="text-base">{blocked.map((preset) => <li><strong>{preset.label}.</strong> {preset.blockedReason}</li>)}</ul>
    </div>
  ) : null}
  <p class="text-base">Official sources: {[...sources].map(([url, title], index) => <>{index > 0 ? "; " : ""}<a href={url} rel="noopener">{title}</a></>)}.</p>
</section>
