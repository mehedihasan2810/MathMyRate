---
import { calculateFees, getFeePreset, type FeePreset } from "@MathMyRate/calculators";
import { findFeeCalculator, salesVolumeLabels, type FeeCalculatorId } from "../data/fee-calculators";
import { formatUsdGrouped } from "../scripts/calculator-form";
import NumberField from "./NumberField.astro";
import ResultRow from "./ResultRow.astro";
import StickyResult from "./StickyResult.astro";

interface Props {
  calculatorId: FeeCalculatorId;
  /** Embedded copies leave out the pinned result bar, which suits a full page rather than an iframe. */
  stickyResult?: boolean;
}

function requirePreset(id: string): FeePreset {
  const preset = getFeePreset(id);

  if (!preset) throw new Error(`The ${id} fee preset is missing from the registry.`);

  return preset;
}

const { calculatorId, stickyResult = true } = Astro.props;

const config = findFeeCalculator(calculatorId);

const volume = config.volume ?? salesVolumeLabels;

const [defaultScenario] = config.scenarios;

if (!defaultScenario) throw new Error(`${config.provider} has no fee scenarios.`);

const defaultPreset = requirePreset(defaultScenario.presetId);

const example = calculateFees({ preset: defaultPreset, grossCents: 10000n });

const acceptsTax = config.scenarios.some((scenario) => requirePreset(scenario.presetId).taxMode === "caller-supplied");

const defaultTaxShown = defaultPreset.taxMode === "caller-supplied";

const amountHelp = defaultTaxShown ? "The full amount charged, including any tax." : "The customer's full order amount.";

const panelClass = config.panelTone === "navy" ? "bg-navy" : "bg-ink";

const scenarioColumns = config.scenarios.length === 3 ? "sm:grid-cols-3" : "sm:grid-cols-2";
---

<div class="mt-8 grid gap-8 lg:grid-cols-[1fr_.85fr]" data-fee-calculator={config.id}>
  <form id="fee-form" data-calculator-form class="print-card rounded-[1.5rem] border border-line bg-[#fafbfd] p-6 shadow-[0_16px_45px_rgba(19,31,51,.08)] md:p-8" novalidate>
    <div class="flex items-baseline justify-between gap-3"><h2 class="display text-2xl font-bold">{config.formHeading}</h2><span class="shrink-0 text-xs text-ink/50">USD / per transaction</span></div>
    <p id="scenario-note" class="mt-2 text-sm text-ink/60">{defaultScenario.note}</p>
    <div data-error-summary role="alert" hidden class="mt-5 rounded-lg border border-[#d99c89] bg-[#fff0e9] p-3 text-sm text-[#8f3c2d]"></div>
    <fieldset class="mt-6">
      <legend class="text-sm font-semibold">{config.scenarioLegend}</legend>
      <div class:list={["mt-3 grid gap-2", scenarioColumns]}>
        {config.scenarios.map((scenario, index) => (
          <label class="flex items-start gap-3 rounded-lg border border-line bg-paper px-4 py-3 text-sm font-medium">
            <input type="radio" name="scenario" value={scenario.id} class="mt-1" checked={index === 0} />
            <span>{scenario.label}<span class="mt-1 block text-xs font-normal text-ink/55">{scenario.description}</span></span>
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset class="mt-6">
      <legend class="text-sm font-semibold">What do you want to work out?</legend>
      <div class="mt-3 grid gap-2 sm:grid-cols-2">
        <label class="flex items-start gap-3 rounded-lg border border-line bg-paper px-4 py-3 text-sm font-medium"><input type="radio" name="feeMode" value="received" class="mt-1" checked /><span>Customer paid an amount<span class="mt-1 block text-xs font-normal text-ink/55">See the fee and what you keep.</span></span></label>
        <label class="flex items-start gap-3 rounded-lg border border-line bg-paper px-4 py-3 text-sm font-medium"><input type="radio" name="feeMode" value="net" class="mt-1" /><span>I want to keep a target<span class="mt-1 block text-xs font-normal text-ink/55">Find what to charge for it.</span></span></label>
      </div>
    </fieldset>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      <NumberField id="amount" label="Amount the customer paid" labelTextId="amount-label" value="100.00" unit="usd" required help={amountHelp} />
      {acceptsTax ? (
        <NumberField id="taxIncluded" wrapperId="tax-field" hidden={!defaultTaxShown} label="Tax collected (optional)" unit="usd" placeholder="0.00" help={config.taxHelp} />
      ) : null}
      <NumberField id="salesPerMonth" label={volume.fieldLabel} inputMode="numeric" placeholder="e.g. 250" help={volume.fieldHelp} />
    </div>
    <div class="calculator-actions mt-7 flex flex-wrap gap-3"><button class="rounded-full bg-ink px-5 py-2.5 text-sm font-bold text-paper" type="button" id="fee-update">Update fees</button><button id="fee-reset" class="rounded-full border border-line px-5 py-2.5 text-sm font-semibold" type="button">Reset example</button></div>
  </form>
  <aside id="fee-panel" data-result-panel aria-live="polite" class:list={["print-card h-fit rounded-[1.5rem] p-7 text-paper shadow-[0_16px_45px_rgba(19,31,51,.16)] md:p-9", panelClass]}>
    <p class="eyebrow !text-[#c3d2ea]" id="primary-label" data-primary-label>You keep from this sale</p>
    <p id="fee-result" data-primary-result class="result-value display mt-4 text-6xl font-bold">{formatUsdGrouped(example.sellerProceedsCents)}</p>
    <p class="mt-1 text-paper/70">before expenses and income tax</p>
    <div class="my-7 border-t border-paper/25"></div>
    <div class="[&>:first-child]:mt-0">
      <ResultRow label={`${config.provider} fee`} valueId="fee-total-result" value={formatUsdGrouped(example.feeCents)} />
      <div id="line-items" class="mt-1">
        {defaultPreset.components.length > 1 ? example.lineItems.map((item) => (
          <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 text-sm text-paper/70"><span>{item.label}</span><strong class="ml-auto text-right text-paper">{formatUsdGrouped(item.feeCents)}</strong></div>
        )) : null}
      </div>
      <ResultRow label="Net after fees" valueId="net-result" value={formatUsdGrouped(example.netAfterFeesCents)} />
      <ResultRow label="Tax collected" valueId="tax-result" value="—" rowId="tax-row" hidden />
      <ResultRow label="You keep after fees and tax" valueId="keep-result" value="—" rowId="keep-row" hidden />
    </div>
    <div id="volume-block" hidden class="mt-6 border-t border-paper/25 pt-5">
      <p class="eyebrow !text-[#c3d2ea]" id="volume-heading">{volume.perPeriod === null ? `Across 1 ${volume.unitSingular}` : `At 1 ${volume.unitSingular} ${volume.perPeriod}`}</p>
      <ResultRow label={volume.feesLabel} valueId="volume-fees-month" value="—" />
      <ResultRow label={volume.keepLabel} valueId="volume-keep-month" value="—" />
      <ResultRow label="Fees per year" valueId="volume-fees-year" value="—" rowId="volume-year-row" hidden={!volume.yearly} />
      <ResultRow label={volume.shareLabel} valueId="volume-rate" value="—" />
    </div>
    <div class="calculator-actions mt-8 flex flex-wrap gap-2"><button id="copy-fee" type="button" class="rounded-full bg-paper px-4 py-2.5 text-sm font-bold text-ink">Copy result</button><button type="button" data-print class="rounded-full border border-paper/35 px-4 py-2.5 text-sm font-bold">Print</button></div>
    <ul class="mt-6 list-disc space-y-1 pl-5 text-sm text-[#ccd8ec]">{example.warnings.map((warning) => <li>{warning}</li>)}</ul>
    <p id="fee-message" class="mt-4 text-sm text-[#ccd8ec]" aria-live="polite"></p>
  </aside>
</div>
{stickyResult ? <StickyResult /> : null}
<noscript><p class="mt-5 rounded-lg border border-line bg-mist p-4 text-sm">JavaScript is required to update this calculator. The example above is a $100.00 {defaultScenario.copyName}; enable JavaScript to calculate your own amounts locally.</p></noscript>

<script>
  import { mountFeeCalculator } from "../scripts/fee-calculator";

  mountFeeCalculator();
</script>
