---
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Site-root-relative path to the social card image, e.g. "/og/home.png". */
  ogImage?: string;
}

const {
  title = "MathMyRate",
  description = "Practical pricing calculators for independent work.",
  noindex = false,
  ogImage = "/og/default.png",
} = Astro.props;

const canonicalUrl = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : null;

// Crawlers require an absolute og:image URL, so like the canonical link it is
// only emitted once a production site is configured.
const ogImageUrl = Astro.site ? new URL(ogImage, Astro.site).href : null;

const footerLinks = [
  { to: "/methodology/", label: "Methodology" },
  { to: "/about/", label: "About" },
  { to: "/privacy/", label: "Privacy" },
  { to: "/terms/", label: "Terms" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#426455" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content="MathMyRate" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    {ogImageUrl ? (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content={title} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
      </>
    ) : null}
  </head>
  <body class="grain min-h-[100dvh]">
    <a href="#main-content" class="sr-only z-[60] rounded bg-ink px-4 py-3 text-paper focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to main content</a>
    <Header />
    <slot />
    <footer class="site-footer border-t border-line px-5 py-10 text-sm text-ink/60 md:px-8">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6">
        <div>
          <p class="display text-base font-bold text-ink">MathMyRate<span class="text-clay">.</span></p>
          <p class="mt-1">Planning tools, not financial advice.</p>
        </div>
        <nav aria-label="Site information" class="flex flex-wrap gap-5">
          {footerLinks.map((link) => (
            <a href={link.to} class="transition-colors hover:text-moss">{link.label}</a>
          ))}
        </nav>
      </div>
    </footer>
  </body>
</html>
