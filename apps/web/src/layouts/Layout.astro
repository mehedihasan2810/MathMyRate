---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { hubs, infoLinks, toolsInHub, type Crumb } from "../data/tools";
import {
  breadcrumbListNode,
  organizationNode,
  serializeStructuredData,
  webApplicationNode,
  webSiteNode,
  type StructuredDataNode,
} from "../lib/structured-data";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Site-root-relative path to the social card image, e.g. "/og/home.png". */
  ogImage?: string;
  /** Visible breadcrumb trail; also emitted as BreadcrumbList structured data. */
  breadcrumbs?: readonly Crumb[];
  /** Calculator pages pass their tool name to be described as a free WebApplication. */
  applicationName?: string;
  /** The home page also describes the site and its calculator search. */
  isHome?: boolean;
}

const {
  title = "MathMyRate",
  description = "Practical pricing calculators for independent work.",
  noindex = false,
  ogImage = "/og/default.png",
  breadcrumbs,
  applicationName,
  isHome = false,
} = Astro.props;

const canonicalUrl = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : null;

// Crawlers require an absolute og:image URL, so like the canonical link it is
// only emitted once a production site is configured.
const ogImageUrl = Astro.site ? new URL(ogImage, Astro.site).href : null;

// Structured data needs absolute URLs, so it follows the canonical-link gate.
const structuredData: StructuredDataNode[] = [];

if (Astro.site && canonicalUrl) {
  if (isHome) structuredData.push(webSiteNode(Astro.site), organizationNode(Astro.site));

  if (applicationName) {
    structuredData.push(webApplicationNode(Astro.site, applicationName, description, Astro.url.pathname));
  }

  if (breadcrumbs && breadcrumbs.length > 1) structuredData.push(breadcrumbListNode(Astro.site, breadcrumbs));
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1f3a5f" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content="MathMyRate" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    {ogImageUrl ? (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content={title} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
      </>
    ) : null}
    {structuredData.map((node) => <script is:inline type="application/ld+json" set:html={serializeStructuredData(node)} />)}
  </head>
  <body class="grain min-h-[100dvh]">
    <a href="#main-content" class="sr-only z-[60] rounded bg-ink px-4 py-3 text-paper focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to main content</a>
    <Header />
    <slot />
    <footer class="site-footer border-t border-line px-5 py-12 text-sm text-ink/65 md:px-8">
      <div class="mx-auto grid max-w-6xl gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_0.8fr]">
        <div>
          <p class="display text-base font-bold text-ink">MathMyRate<span class="text-gold">.</span></p>
          <p class="mt-2 max-w-xs leading-relaxed">Free pricing and payment-fee calculators. Planning tools, not financial advice.</p>
        </div>
        {hubs.map((hub) => (
          <nav aria-label={`${hub.name} calculators`}>
            <a href={hub.href} class="font-semibold text-ink transition-colors hover:text-navy">{hub.name}</a>
            <ul class="mt-3 space-y-2">
              {toolsInHub(hub.id).map((tool) => (
                <li><a href={tool.href} class="transition-colors hover:text-navy">{tool.name}</a></li>
              ))}
            </ul>
          </nav>
        ))}
        <nav aria-label="Site information">
          <p class="font-semibold text-ink">Site</p>
          <ul class="mt-3 space-y-2">
            {infoLinks.map((link) => (
              <li><a href={link.href} class="transition-colors hover:text-navy">{link.name}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </footer>
    <script>
      // Print buttons use a bundled listener instead of inline onclick handlers,
      // so pages stay compatible with a strict Content Security Policy.
      document.querySelectorAll<HTMLButtonElement>("button[data-print]").forEach((button) => {
        button.addEventListener("click", () => window.print());
      });
    </script>
  </body>
</html>
