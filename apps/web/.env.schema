# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
PUBLIC_SERVER_URL=

# Production origin, for example https://www.example.com. It turns on canonical
# URLs, the sitemap, structured data, and crawlable robots.txt. Leave it empty
# for preview and local builds, which stay noindexed.
# @public @type=url @optional
PUBLIC_SITE_URL=

# Set to true for production builds so a missing PUBLIC_SITE_URL fails the build.
# Alchemy's production stage (ALCHEMY_STAGE=production) has the same effect.
# @public @type=enum(true, false) @optional
REQUIRE_SITE_URL=
